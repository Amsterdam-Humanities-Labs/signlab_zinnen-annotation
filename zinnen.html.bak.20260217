<!DOCTYPE html>
<html lang="en">
<head>
  <script src="/userProtect.js"></script>
    <meta charset="UTF-8">
    <title>Interactive Sentences Table with Sortable Labels</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
      crossorigin="anonymous"></script>

    <style>
        .hover-info {
            position: absolute;
            background-color: white;
            border: 1px solid #ddd;
            padding: 10px;
            z-index: 1000;
            display: none;
            width: 200px;
            height: 300px;
        }
        .hover-info video {
            width: 200px;
            height: 300px;
        }
        .edit-symbol {
            cursor: pointer;
            margin-left: 10px;
            color: #007bff;
        }
        .edit-input {
            width: 100%;
        }
        .video-column {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }
        .portrait-video, .portrait-thumbnail {
            width: 200px;
            height: 300px;
            object-fit: cover;
            background-color: black;
            cursor: pointer;
        }
        .video-buttons {
            margin-top: 10px;
            display: flex;
            gap: 5px;
            justify-content: center;
        }
        .zin-input {
            width: 100%;
        }
        .filter-container {
            margin-bottom: 20px;
        }
        .bootstrap-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-gap: 20px;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 1px solid #ddd;
            padding: 10px 0;
            position: relative; /* Ensure that subtitle divs are positioned relative to this container */
        }
        .sentence-text {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        /* New class for rows with at least one EAF file */
        .eaf-present {
            background-color: #d0e7ff; /* Light blue color */
        }

        /* Additional styles for the new elements */
        .status-video-select, .global-status-select, .search-bar {
            max-width: 200px;
        }
        .status-annotatie-select, .status-glos-select, .status-gvg-select {
            max-width: 200px;
        }
        .comments-field {
            width: 100%;
            margin-top: 10px;
        }
        
        /* Page info styling */
        #pageInfo {
            background-color: #f8f9fa;
            cursor: default;
            user-select: none;
        }

        /* Subtitle styling */
        .subtitle {
            right: 0;
            text-align: center;
            color: white;
            padding: 5px;
            border-radius: 3px;
            font-size: 14px;
            height: 30px;
            position: absolute;

        }

        /* Stack multiple subtitles vertically */
        .Nederlands {
            top: 10px; /* Position above the first subtitle */
        }

        .glossen {
            top: 50px; /* Position above the second subtitle */
        }
        .Gebaar-voor-gebaar {
            top: 80px; /* Position above the third subtitle */
        }

/* Drop-Zone Styles */
.drop-zone {
    border: 2px dashed #ccc;
    border-radius: 5px;
    padding: 30px;
    text-align: center;
    color: #ccc;
    cursor: pointer;
    transition: background-color 0.3s, border-color 0.3s;
}
.drop-zone.dragover {
    background-color: #f0f8ff;
    border-color: #333;
    color: #333;
}
.drop-zone p {
    margin: 0;
    font-size: 16px;
}
.progress {
    height: 25px;
}

.resetStatusBtn{
    display: none;
}
.resetDiv{
    text-align: center;
}

    </style>
</head>
<body>
    <div class="container mt-4">
        <h2 class="mb-4">signCollect Zinnen Interface</h2>
        <button class="btn btn-secondary mb-3" id="viewLogsBtn">View Logs</button>
        <button class="btn btn-primary mb-3" id="FreeuploadEAFBtn">Upload EAF</button>
                <!-- new a href link to addZinnen.html -->
        <a href="addZinnen.html" class="btn btn-primary mb-3">Nieuwe Zinnen</a>
        <a href="action_stats.html" class="btn btn-info mb-3">Statistieken</a>

        <!-- NEW: Counts container -->
        <div id="countsSection" class="d-flex flex-wrap gap-2 align-items-center ms-3"></div>


        <!-- Thema Filter, Search Bar, and Status Filters -->
        <div class="filter-container d-flex flex-wrap align-items-end gap-3">
            <!-- Thema Filter -->
            <div>
                <label for="themaFilter">Filter by Thema:</label>
                <select id="themaFilter" class="form-select">
                    <option value="">All Themas</option>
                    <!-- Options will be populated dynamically -->
                </select>
            </div>

            <!-- Search Bar -->
            <div class="flex-grow-1">
                <label for="searchBar">Search Sentences:</label>
                <input type="text" id="searchBar" class="form-control search-bar" placeholder="Enter sentence keywords...">
            </div>
            <div class="flex-grow-1">
                <label for="searchGloss">Search glosses:</label>
                <input type="text" id="searchGloss" class="form-control search-bar" placeholder="Enter gloss keyword...">
            </div>
            <div class="flex-grow-1">
                <label for="searchGVG">Search Gebaar-voor-Gebaar:</label>
                <input type="text" id="searchGVG" class="form-control search-bar" placeholder="Enter GVG keyword...">
            </div>
            <!-- Status Filters -->
            <div>
                <label for="statusVideoFilter">Filter by Status Video Controle:</label>
                <select id="statusVideoFilter" class="form-select status-video-select">
                    <option value="Niet Klaar">Niet Klaar</option>
                    <option value="Klaar">Klaar</option>
                    <option value="" selected>Leeg/Empty</option>
                    <option value="signbank">Niet voor app, verplaatsen naar Signbank</option>
                </select>
            </div>
            <div>
                <label for="statusAnnotatieFilter">Filter by Status Nederlands:</label>
                <select id="statusAnnotatieFilter" class="form-select status-annotatie-select">
                    <option value="Niet Klaar">Niet Klaar</option>
                    <option value="Klaar">Klaar</option>
                    <option value="" selected>Leeg/Empty</option>
                    <option value="Controle nodig">Controle nodig</option>
                </select>
            </div>
            <div>
                <label for="statusGlosFilter">Filter by Status Glossen:</label>
                <select id="statusGlosFilter" class="form-select status-glos-select">
                    <option value="Niet Klaar">Niet Klaar</option>
                    <option value="Klaar">Klaar</option>
                    <option value="" selected>Leeg/Empty</option>
                    <option value="NVT">NVT</option>
                </select>
            </div>
            <div>
                <label for="statusGvgFilter">Filter by Status Gebaar voor Gebaar:</label>
                <select id="statusGvgFilter" class="form-select status-gvg-select">
                    <option value="Niet Klaar">Niet Klaar</option>
                    <option value="Klaar">Klaar</option>
                    <option value="" selected>Leeg/Empty</option>
                    <option value="Check nodig">Check nodig</option>
                </select>
            </div>

            <!-- Motion Capture Filter -->
            <div>
                <label for="motionCaptureFilter">Filter by Motion Capture:</label>
                <select id="motionCaptureFilter" class="form-select">
                    <option value="" selected>All</option>
                    <option value="1">Has Motion Capture</option>
                    <option value="0">No Motion Capture</option>
                </select>
            </div>

            <!-- MCP Status Postprocessing Filter -->
            <div>
                <label for="mcpStatusPostprocessingFilter">Filter by MCP - Status Postprocessing:</label>
                <select id="mcpStatusPostprocessingFilter" class="form-select mcp-status-postprocessing-select">
                    <option value="" selected>Leeg/Empty</option>
                    <option value="Niet Klaar">Niet Klaar</option>
                    <option value="Klaar">Klaar</option>
                    <option value="Check nodig">Check nodig</option>
                </select>
            </div>

            <!-- MCP Status Tijd Annotatie Filter -->
            <div>
                <label for="mcpStatusTijdAnnotatieFilter">Filter by MCP - Status Tijd Annotatie Gloss:</label>
                <select id="mcpStatusTijdAnnotatieFilter" class="form-select mcp-status-tijd-annotatie-select">
                    <option value="" selected>Leeg/Empty</option>
                    <option value="Niet Klaar">Niet Klaar</option>
                    <option value="Klaar">Klaar</option>
                    <option value="Check nodig">Check nodig</option>
                </select>
            </div>

            <!-- MCP Status Tijd Annotatie GVG Filter -->
            <div>
                <label for="mcpStatusTijdAnnotatieGvgFilter">Filter by MCP - Status Tijd annotatie Gebaar voor Gebaar/Nederlands:</label>
                <select id="mcpStatusTijdAnnotatieGvgFilter" class="form-select mcp-status-tijd-annotatie-gvg-select">
                    <option value="" selected>Leeg/Empty</option>
                    <option value="Niet Klaar">Niet Klaar</option>
                    <option value="Klaar">Klaar</option>
                    <option value="Check nodig">Check nodig</option>
                </select>
            </div>

            <!-- Global Status Select Menu -->
            <!-- <div>
                <label for="globalStatusSelect">Video controle:</label>
                <div class="input-group">
                    <select id="globalStatusSelect" class="form-select global-status-select">
                        <option value="Niet Klaar">Niet Klaar</option>
                        <option value="Klaar">Klaar</option>
                        <option value="Toch publiceren">Toch publiceren</option>
                    </select>
                    <button id="applyGlobalStatusBtn" class="btn btn-primary">Apply</button>
                </div>
            </div> -->
        </div>
        <div class="reset-button-container mt-3">
            <button id="resetFiltersBtn" class="btn btn-secondary">Reset Filters</button>
        </div>


        <div id="tableContainer">
            <!-- Table will be dynamically inserted here -->
        </div>
        <div id="resetDiv">
        <button id="resetStatusBtn" class="btn btn-secondary">Reset All Status to empty</button>
    </div>
        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-center">
                <li class="page-item" id="prevPageItem"><a class="page-link" href="#" id="prevPage">Previous</a></li>
                <li class="page-item"><span class="page-link" id="pageInfo">Page 1 of 1</span></li>
                <li class="page-item" id="nextPageItem"><a class="page-link" href="#" id="nextPage">Next</a></li>
            </ul>
        </nav>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="deleteConfirmationModalLabel">Confirm Deletion</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            Are you sure you want to delete this video?
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Upload EAF Modal -->
    <div class="modal fade" id="uploadEAFModal" tabindex="-1" aria-labelledby="uploadEAFModalLabel" aria-hidden="true">
        <div class="modal-dialog">
          <form id="uploadEAFForm" enctype="multipart/form-data">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="uploadEAFModalLabel">Upload EAF File</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <input type="hidden" id="uploadVideoFilename" name="videoFilename" value="">
                  <!-- Add this hidden input to store the row ID -->
                  <input type="hidden" id="uploadVideoRowId" name="videoRowId" value="">
                  <input type="hidden" id="uploadVideoZin" name="videoZin" value=""> 
                  <div class="mb-3">
                      <label for="eafFileInput" class="form-label">Select EAF File:</label>
                      <input class="form-control" type="file" id="eafFileInput" name="eafFile" accept=".eaf,application/xml,text/xml" required>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-primary">Upload</button>
                </div>
              </div>
          </form>
        </div>
      </div>

    <!-- Delete EAF Confirmation Modal -->
    <div class="modal fade" id="deleteEAFConfirmationModal" tabindex="-1" aria-labelledby="deleteEAFConfirmationModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="deleteEAFConfirmationModalLabel">Confirm Delete EAF</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            Are you sure you want to delete the EAF file for this video?
          </div>

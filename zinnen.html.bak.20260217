});

let currentPage = 1;
let totalPages = 1;
let currentThema = ""; // Default loading theme
let themas = [];
let videoArray = [];
let isFetching = false; // Flag to prevent multiple concurrent fetches
let videoToDelete = null; // Object to store video details for deletion
let videoToDeleteEAF = null; // Object to store EAF details for deletion
let searchQuery = "";
let statusVideoFilter = "";
let statusAnnotatieFilter = "";
let statusGlosFilter = "";
let statusGvgFilter = "";
let motionCaptureFilter = ""; // For has_mocap filtering
let mcpStatusPostprocessingFilter = ""; // For MCP postprocessing status
let mcpStatusTijdAnnotatieFilter = ""; // For MCP tijd annotatie status
let mcpStatusTijdAnnotatieGvgFilter = ""; // For MCP tijd annotatie GVG status
let eventListenersAttached = false;
let searchGloss = "";
let searchGVG = "";
const urlParams = new URLSearchParams(window.location.search);
searchGloss = urlParams.get('searchGloss') || "";
searchGVG = urlParams.get('searchGVG') || "";

/**
 * Sanitize HTML to prevent XSS
 */

/**
 * Debounce function to limit the rate at which a function can fire.
 */
function debounce(func, wait) {
    let timeout;
    return function(...args) {
        clearTimeout(timeout);
        timeout = setTimeout(() => func.apply(this, args), wait);
    };
}

// Modified loadSentences function - Always show the reset button
async function loadSentences(page = 1, thema = '', search = "", statusVideo = "",
                             statusAnnotatie = "", statusGlos = "", statusGvg = "",
                             mcpStatusPostprocessing = "", mcpStatusTijdAnnotatie = "",
                             motionCapture = "", searchGloss = "", searchGVG = "",
                             mcpStatusTijdAnnotatieGvg = "") {
    // Prevent initiating another fetch if one is already in progress
    if (isFetching) {
        console.warn('Fetch already in progress. Skipping loadSentences call.');
        return;
    }

    isFetching = true; // Set the fetching flag
    // console.log(`Loading sentences for page: ${page}, thema: ${thema}, search: ${search}, status: ${status}, statusAnnotatie: ${statusAnnotatie}, statusGlos: ${statusGlos}, statusVideo: ${statusVideo}`);
    //show loading spinner
    document.getElementById('tableContainer').innerHTML = '<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>';
    // Construct query parameters
    let queryParams = `page=${page}&thema=${encodeURIComponent(thema)}`;

    if (search) queryParams += `&search=${encodeURIComponent(search)}`;
    if (statusVideo) queryParams += `&statusVideo=${encodeURIComponent(statusVideo)}`;
    if (statusAnnotatie) queryParams += `&statusAnnotatie=${encodeURIComponent(statusAnnotatie)}`;
    if (statusGlos) queryParams += `&statusGlos=${encodeURIComponent(statusGlos)}`;
    if (statusGvg) queryParams += `&statusGvg=${encodeURIComponent(statusGvg)}`;
    if (mcpStatusPostprocessing) queryParams += `&mcpStatusPostprocessing=${encodeURIComponent(mcpStatusPostprocessing)}`;
    if (mcpStatusTijdAnnotatie) queryParams += `&mcpStatusTijdAnnotatie=${encodeURIComponent(mcpStatusTijdAnnotatie)}`;
    if (mcpStatusTijdAnnotatieGvg) queryParams += `&mcpStatusTijdAnnotatieGvg=${encodeURIComponent(mcpStatusTijdAnnotatieGvg)}`;
    if (motionCapture) queryParams += `&motionCapture=${encodeURIComponent(motionCapture)}`;
    if (searchGloss) queryParams += `&searchGloss=${encodeURIComponent(searchGloss)}`;
    if (searchGVG) queryParams += `&gvg=${encodeURIComponent(searchGVG)}`;
    console.log(`getZinnen.php?${queryParams}`)

    try {
        const response = await fetch(`getZinnen.php?${queryParams}`);
        const data = await response.json();
        // console.log(data)

        if (!data.success) {
            console.error('Failed to load sentences:', data.error);
            isFetching = false;
            return;
        }

        //we are going to empty the tableContainer and populate it with the new data


        const tableContainer = document.getElementById('tableContainer');
        tableContainer.innerHTML = ''; // Clear the table container
        
        videoArray = data.rows;

        // Update pagination info from server response
        if (data.pagination) {
            currentPage = data.pagination.currentPage;
            totalPages = data.pagination.totalPages;
            
            // Update page info display
            document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages}`;
        }

        // Show/hide navigation buttons based on current page and total pages
        if (currentPage > 1) {
            document.getElementById('prevPageItem').style.display = 'block';
        } else {
            document.getElementById('prevPageItem').style.display = 'none';
        }

        if (currentPage < totalPages) {
            document.getElementById('nextPageItem').style.display = 'block';
        } else {
            document.getElementById('nextPageItem').style.display = 'none';
        }

        // Always show the reset button instead of conditionally showing it
        document.getElementById('resetStatusBtn').style.display = 'block';

        // Map each row to its HTML
        const rowPromises = data.rows.map(async row => {
            // console.log('Row:', row);
            const zin = row.zinArray.join('_');

            // Fetch all videos' data concurrently
            const videosHTMLArray = await Promise.all(row.videos.map(async (video, videoIndex) => {
                try {
                    const fileResponse = await fetch(`getMT.php?id=${row.ID}&videoIndex=${videoIndex}`);
                    const fileData = await fileResponse.json();

                    if (fileData.success) {
                        const videoCenter = fileData.m_file;
                        const videoA = fileData.a_file;
                        const videoB = fileData.b_file;
                        const post_processed = fileData.post_processed;
                        let thumbnailPath;

                        if (post_processed === "1") {
                            thumbnailPath = `https://signcollect.nl/gebarenoverleg_media/studioFilesMini/post/${fileData.thumbnail}`;
                        } else {
                            thumbnailPath = `https://signcollect.nl/gebarenoverleg_media/studioFilesMini/raw/${fileData.thumbnail}`;
                        }

                        // Check for subtitle files
                        const subArray = [fileData.srt_nederlands, fileData.srt_signbank_id_glossen, fileData.srt_gebaar_voor_gebaar];
                        // console.log(row.ID, videoIndex);
                        // Generate Subtitle Divs
                        let subtitleDivs = '';
                        subArray.forEach(srtPath => {
                            if (srtPath) {
                                //convert srt_M20240925_1884_Nederlands to Nederlands
                                var subtitleType = srtPath.split('_').slice(-1)[0];
                                //remove extension from subtitletype
                                subtitleType = subtitleType.split('.').slice(0, -1)

                                subtitleDivs += `
                                    <div class="subtitle ${subtitleType}">
                                        <span class="subtitle-text"></span>
                                    </div>
                                `;
                            }
                        });

                        // Determine if this video has an EAF file
                        const eafClass = video.eaf ? 'eaf-present' : '';
                        return `
                            <div class="video-container mb-2 ${eafClass}" id="videoContainer-${row.ID}-${videoIndex}" data-filename="${videoCenter}" style="position: relative;">
                                <img
                                    src="${thumbnailPath}"
                                    alt="Video Thumbnail"
                                    class="portrait-thumbnail"
                                    data-id="${row.ID}"
                                    data-videoindex="${videoIndex}"
                                    data-thumbnail="${thumbnailPath}"
                                    data-filename="${videoCenter}"
                                    data-postprocessed="${post_processed}"
                                    style="width:200px; height:300px; object-fit:cover; cursor:pointer; margin-right: 10px;"
                                    onerror="if(this.src.includes('/post/')){console.log('Thumbnail 404, trying raw:',this.src);this.src=this.src.replace('/post/','/raw/');}"
                                >
                                        <!-- Subtitle Divs -->
                                ${subtitleDivs}
                                ${video.eaf ? `
                                <div class="eaf" style="flex-grow: 1;">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>EAF Signbank Glossen</th>
                                                <th>EAF Nederlands</th>
                                                <th>EAF Gebaar voor Gebaar</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>${"Aantal items: " + (video.eaf_signbank_glossen || 'Leeg')}</td>
                                                <td>${"Aantal items: " + (video.eaf_nederlands || 'Leeg')}</td>
                                                <td>${"Aantal items: " + (video.eaf_gebaar_voor_gebaar || 'Leeg')}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                ` : ''}
                        
                            </div>
                            <!-- Action Buttons -->
                            <div class="video-buttons mt-2">
                                <button class="btn btn-sm btn-secondary duplicate-btn" data-id="${row.ID}" data-videoindex="${videoIndex}" data-filename="${videoCenter}">Verplaatsen naar nieuwe zin</button>
                                <button class="btn btn-sm btn-primary downloadEAF-btn" data-filename="${videoCenter}"  data-post-processed="${post_processed}" data-zin="${zin}">Download EAF (AVI)</button>
                                <button class="btn btn-sm btn-primary downloadEAFMP4-btn" data-filename="${videoCenter}"  data-post-processed="${post_processed}" data-zin="${zin}">Download EAF (MP4)</button>
                                <button class="btn btn-sm btn-primary downloadZIP-btn" data-filename="${videoCenter}"  data-post-processed="${post_processed}" data-zin="${zin}">Download ZIP File</button>

                                <button class="btn btn-sm btn-success downloadMP4-btn" data-filename="${videoCenter}" data-filename-a="${videoA}" data-filename-b="${videoB}" data-post-processed="${post_processed}" data-zin="${zin}">Download</button>
                                <button class="btn btn-sm btn-warning uploadEAF-btn" data-filename="${videoCenter}" data-zin="${zin}">Upload EAF</button>
                                <button class="btn btn-sm btn-danger delete-btn" data-id="${row.ID}" data-videoindex="${videoIndex}" data-filename="${videoCenter}">Delete video</button>
                                <button class="btn btn-sm btn-danger editEAF-btn" data-id="${row.ID}" data-videoindex="${videoIndex}" data-filename="${videoCenter}">Bewerk EAF</button>

                                <!-- Motion Capture Editor Button (conditionally rendered) -->
                                ${video.has_mocap == 1 ? `
                                    <button class="btn btn-sm btn-info editMocap-btn"
                                            data-id="${row.ID}"
                                            data-videoindex="${videoIndex}"
                                            data-filename="${videoCenter}">
                                        Bewerk Motion Capture
                                    </button>
                                ` : ''}

                                <!-- Delete EAF Button -->
                                <button class="btn btn-sm btn-outline-danger deleteEAF-btn" data-id="${row.ID}" data-videoindex="${videoIndex}" data-filename="${videoCenter}" data-zin="${zin}" ${!video.eaf ? 'disabled' : ''}>
                                    <i class="fas fa-trash-alt"></i> Delete EAF
                                </button>
                            </div>
                        `;
                    } else {
                        console.error('Failed to fetch video data:', fileData.error);
                        return ''; // Return empty string or a placeholder
                    }
                } catch (error) {
                    console.error('Error fetching video data:', error);
                    return ''; // Return empty string or a placeholder
                }
            }));

            const videosHTML = videosHTMLArray.join(''); // Combine all video HTMLs
            const sanitizedZin = sanitizeHTML(row.zinArray.join(' '));

            // Add the new elements: Status Select, Comments Field, and View Videos Button
            return `
                <div class="bootstrap-grid" data-row-id="${row.ID}">
                    <div class="sentence-text">
                        <input type="text" class="zin-input form-control" value="${sanitizedZin}" data-id="${row.ID}">
                        <!-- Comments Field -->
                        <textarea class="form-control comments-field" placeholder="Add comments..." data-id="${row.ID}">${row.comments || ''}</textarea>
                        <!-- Status Select Menus -->
                        <div class="d-flex flex-column gap-2 mt-2">
                            <div class="d-flex align-items-center">
                                <label class="me-2">Status Video Controle:</label>
                                <select class="form-select status-video-select" data-id="${row.ID}">
                                    <option value="" ${row.status_video === '' ? 'selected' : ''}>Leeg/Empty</option>
                                    <option value="Niet Klaar" ${row.status_video === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                                    <option value="Klaar" ${row.status_video === 'Klaar' ? 'selected' : ''}>Klaar</option>
                                    <option value="signbank" ${row.status_video === 'signbank' ? 'selected' : ''}>Niet voor app, verplaatsen naar Signbank</option>
                                </select>
                            </div>
                            <div class="d-flex align-items-center">
                                <label class="me-2">Status Nederlands:</label>
                                <select class="form-select status-annotatie-select" data-id="${row.ID}">
                                    <option value="" ${row.status_annotatie === '' ? 'selected' : ''}>Leeg/Empty</option>
                                    <option value="Niet Klaar" ${row.status_annotatie === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                                    <option value="Klaar" ${row.status_annotatie === 'Klaar' ? 'selected' : ''}>Klaar</option>
                                    <option value="Controle nodig" ${row.status_annotatie === 'Controle nodig' ? 'selected' : ''}>Controle nodig</option>
                                </select>
                            </div>
                            <div class="d-flex align-items-center">
                                <label class="me-2">Status Glossen:</label>
                                <select class="form-select status-glos-select" data-id="${row.ID}">
                                    <option value="" ${row.status_glos === '' ? 'selected' : ''}>Leeg/Empty</option>
                                    <option value="Niet Klaar" ${row.status_glos === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                                    <option value="Klaar" ${row.status_glos === 'Klaar' ? 'selected' : ''}>Klaar</option>
                                    <option value="NVT" ${row.status_glos === 'NVT' ? 'selected' : ''}>NVT</option>
                                </select>
                            </div>
                            <div class="d-flex align-items-center">
                                <label class="me-2">Status Gebaar voor Gebaar:</label>
                                <select class="form-select status-gvg-select" data-id="${row.ID}">
                                    <option value="" ${row.status_gvg === '' ? 'selected' : ''}>Leeg/Empty</option>
                                    <option value="Niet Klaar" ${row.status_gvg === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                                    <option value="Klaar" ${row.status_gvg === 'Klaar' ? 'selected' : ''}>Klaar</option>
                                    <option value="Check nodig" ${row.status_gvg === 'Check nodig' ? 'selected' : ''}>Check nodig</option>
                                </select>
                            </div>

                            <div class="d-flex align-items-center">
                                <label class="me-2">MCP - Status Postprocessing:</label>
                                <select class="form-select mcp-status-postprocessing-select" data-id="${row.ID}">
                                    <option value="" ${row.mcp_status_postprocessing === '' || row.mcp_status_postprocessing === null ? 'selected' : ''}>Leeg/Empty</option>
                                    <option value="Niet Klaar" ${row.mcp_status_postprocessing === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                                    <option value="Klaar" ${row.mcp_status_postprocessing === 'Klaar' ? 'selected' : ''}>Klaar</option>
                                    <option value="Check nodig" ${row.mcp_status_postprocessing === 'Check nodig' ? 'selected' : ''}>Check nodig</option>
                                </select>
                            </div>

                            <div class="d-flex align-items-center">
                                <label class="me-2">MCP - Status Tijd Annotatie Gloss:</label>
                                <select class="form-select mcp-status-tijd-annotatie-select" data-id="${row.ID}">
                                    <option value="" ${row.mcp_status_tijd_annotatie === '' || row.mcp_status_tijd_annotatie === null ? 'selected' : ''}>Leeg/Empty</option>
                                    <option value="Niet Klaar" ${row.mcp_status_tijd_annotatie === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                                    <option value="Klaar" ${row.mcp_status_tijd_annotatie === 'Klaar' ? 'selected' : ''}>Klaar</option>
                                    <option value="Check nodig" ${row.mcp_status_tijd_annotatie === 'Check nodig' ? 'selected' : ''}>Check nodig</option>
                                </select>
                            </div>

                            <div class="d-flex align-items-center">
                                <label class="me-2">MCP - Status Tijd annotatie Gebaar voor Gebaar/Nederlands:</label>
                                <select class="form-select mcp-status-tijd-annotatie-gvg-select" data-id="${row.ID}">
                                    <option value="" ${row.mcp_status_tijd_annotatie_gvg === '' || row.mcp_status_tijd_annotatie_gvg === null ? 'selected' : ''}>Leeg/Empty</option>
                                    <option value="Niet Klaar" ${row.mcp_status_tijd_annotatie_gvg === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                                    <option value="Klaar" ${row.mcp_status_tijd_annotatie_gvg === 'Klaar' ? 'selected' : ''}>Klaar</option>
                                    <option value="Check nodig" ${row.mcp_status_tijd_annotatie_gvg === 'Check nodig' ? 'selected' : ''}>Check nodig</option>
                                </select>
                            </div>
                        </div>
                        <!-- View Videos Button -->
                        <button class="btn btn-sm btn-info mt-2 view-videos-btn" data-row-id="${row.ID}">View Videos</button>
                        <button class="btn btn-sm btn-info mt-2 delete-zin-btn" data-row-id="${row.ID}">Delete Sentence</button>

                    </div>
                    <div class="video-column">
                        ${videosHTML}
                    </div>
                </div>
            `;
        });

        // Wait for all rows to be processed
        const allRowHTMLs = await Promise.all(rowPromises);
        const completeGridHTML = allRowHTMLs.join('');
        tableContainer.innerHTML = completeGridHTML;
        // Sleep for 1 second before attaching event listeners
        await new Promise(resolve => setTimeout(resolve, 1000));
        if(!eventListenersAttached)
        {
        addEventListeners();
        addZinInputEventListeners();
        addCommentsEventListeners();
        addStatusSelectEventListeners();
        addViewVideosButtonEventListeners();
        eventListenersAttached = true;
        }



    } catch (error) {
        console.error('Error loading sentences:', error);
    } finally {
        isFetching = false; // Reset the fetching flag
    }
}

function populateThemaFilter() {
    fetch('getZinnen.php?action=fetchThemas')
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const themaFilter = document.getElementById('themaFilter');
                data.themas.forEach(thema => {
                    const option = document.createElement('option');
                    option.value = thema;
                    option.textContent = thema;
                    themaFilter.appendChild(option);
                });
            } else {
                console.error('Failed to fetch themas:', data.error);
            }
        })
        .catch(error => {
            console.error('Error fetching themas:', error);
        });
}

function addEventListeners() {
    if (window.eventListenersAttached) return;
    window.eventListenersAttached = true;

    const container = document.getElementById('tableContainer'); 

    // Mouseenter for thumbnails
    container.addEventListener('mouseenter', function(e) {
        if (e.target && e.target.classList.contains('portrait-thumbnail')) {
            // console.log('Mouse entered thumbnail:', e.target);
            handleThumbnailMouseEnter(e.target);
        }
    }, true);

    // Mouseleave for videos
    container.addEventListener('mouseleave', function(e) {
        if (e.target && e.target.classList.contains('portrait-video')) {
            // console.log('Mouse left video:', e.target);
            handleVideoMouseLeave(e.target);
        }
    }, true);

    // Click on thumbnails
    container.addEventListener('click', function(e) {
        if (e.target && e.target.classList.contains('portrait-thumbnail')) {
            // console.log('Thumbnail clicked:', e.target);
            handleThumbnailClick(e.target);
        }
    });

    // Click on buttons
    container.addEventListener('click', function(e) {
        if (e.target && e.target.classList.contains('duplicate-btn')) {
            // console.log('Duplicate button clicked:', e.target);
            const rowId = e.target.getAttribute('data-id');
            const videoIndex = e.target.getAttribute('data-videoindex');
            const filename = e.target.getAttribute('data-filename');
            handleDuplicateRowButton(rowId, videoIndex, filename, e.target);
        }

        if (e.target && e.target.classList.contains('delete-btn')) {
            // console.log('Delete button clicked:', e.target);
            const rowId = e.target.getAttribute('data-id');
            const videoIndex = e.target.getAttribute('data-videoindex');
            const filename = e.target.getAttribute('data-filename');
            handleDeleteButtonClick(rowId, videoIndex, filename);
        }

        if (e.target && e.target.classList.contains('downloadEAF-btn')) {
            // console.log('Download EAF button clicked:', e.target);
            const filename = e.target.getAttribute('data-filename');
            const post_processed = e.target.getAttribute('data-post-processed');
            const zin = e.target.getAttribute('data-zin');
            downloadEAF(filename, post_processed, zin);
        }

        
        if (e.target && e.target.classList.contains('downloadEAFMP4-btn')) {
            // console.log('Download EAF MP4 button clicked:', e.target);
            const filename = e.target.getAttribute('data-filename');
            const post_processed = e.target.getAttribute('data-post-processed');
            const zin = e.target.getAttribute('data-zin');
            downloadEAFMP4(filename, post_processed, zin);
        }

        if (e.target && e.target.classList.contains('downloadMP4-btn')) {
            // console.log('Download MP4 button clicked:', e.target);
            const filename = e.target.getAttribute('data-filename');
            const filename_a = e.target.getAttribute('data-filename-a');
            const filename_b = e.target.getAttribute('data-filename-b');
            const post_processed = e.target.getAttribute('data-post-processed');
            const zin = e.target.getAttribute('data-zin');
            downloadMP4(filename, filename_a, filename_b, post_processed, zin);
        }

        if (e.target && e.target.classList.contains('uploadEAF-btn')) {
            // console.log('Upload EAF button clicked:', e.target);
            const filename = e.target.getAttribute('data-filename');
            const zin = e.target.getAttribute('data-zin');
            const rowId = e.target.closest('.bootstrap-grid').getAttribute('data-row-id');
            openUploadEAFModal(filename, rowId, zin);
        }

        if (e.target && e.target.classList.contains('view-videos-btn')) {
            // console.log('View Videos button clicked:', e.target);
            const rowId = e.target.getAttribute('data-row-id');
            viewVideos(rowId);
        }

        if (e.target && e.target.classList.contains('delete-zin-btn')) {
            // console.log('Delete Sentence button clicked:', e.target);
            const rowId = e.target.getAttribute('data-row-id');
            handleDeleteZinButtonClick(rowId);
        }

        if (e.target && e.target.classList.contains('deleteEAF-btn')) {
            // console.log('Delete EAF button clicked:', e.target);
            const rowId = e.target.getAttribute('data-id');
            const videoIndex = e.target.getAttribute('data-videoindex');
            const filename = e.target.getAttribute('data-filename');
            const zinArray = e.target.getAttribute('data-zin');
            handleDeleteEAFButtonClick(rowId, videoIndex, filename, zinArray);
        }

        //button used for triggering download ZIP file by calling downloadZIP.php
        if (e.target && e.target.classList.contains('downloadZIP-btn')) {
            // console.log('Download ZIP button clicked:', e.target);
            const filename = e.target.getAttribute('data-filename');
            const post_processed = e.target.getAttribute('data-post-processed');
            const zin = e.target.getAttribute('data-zin');
            downloadZIP(filename, post_processed, zin);
        }

        //redirect to addZin.html?filename=filename for editEAF button
        if (e.target && e.target.classList.contains('editEAF-btn')){
            const rowId = e.target.getAttribute('data-id');
            const videoIndex = e.target.getAttribute('data-videoindex');
            const filename = e.target.getAttribute('data-filename');
            saveCurrentState();
            window.location.href = `subBeta4.html?filename=${filename}`;

        }

        // Redirect to 3DAnn1.html for Motion Capture editing
        if (e.target && e.target.classList.contains('editMocap-btn')) {
            const filename = e.target.getAttribute('data-filename');

            // Fetch latest FBX file dynamically when button is clicked
            fetch(`getZinnen.php?action=getLatestMocapFile&mFile=${encodeURIComponent(filename)}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.hasMocap) {
                        // Replace .fbx extension with .glb
                        const glbFilename = data.fbxFilename.replace(/\.fbx$/i, '.glb');
                        const glbUrl = `/gebarenoverleg_media/fbx/${glbFilename}`;
                        saveCurrentState();
                        window.location.href = `3DAnn1.html?glb=${encodeURIComponent(glbUrl)}`;
                    } else {
                        alert('No motion capture file found for this video.');
                    }
                })
                .catch(error => {
                    console.error('Error fetching mocap file:', error);
                    alert('Error loading motion capture data.');
                });
        }

    });
}

async function handleDuplicateRowButton(rowId, videoIndex, filename, buttonElement) {
    duplicateRowDetails = { rowId, videoIndex, filename, buttonElement };
    const duplicateModal = new bootstrap.Modal(document.getElementById('duplicateConfirmationModal'));
    duplicateModal.show();
}

// Event listener for confirming duplicate
document.getElementById('confirmDuplicateBtn').addEventListener('click', async function() {
    if (duplicateRowDetails) {
        const { rowId, videoIndex, filename, buttonElement } = duplicateRowDetails;
        // Hide the modal
        const duplicateModalEl = document.getElementById('duplicateConfirmationModal');
        const duplicateModal = bootstrap.Modal.getInstance(duplicateModalEl);
        duplicateModal.hide();
        // Call the duplicateRow function
        await duplicateRow(rowId, videoIndex, filename, buttonElement);
        duplicateRowDetails = null;
    }
});


async function handleThumbnailMouseEnter(thumbnail) {
    const rowId = thumbnail.getAttribute('data-id');
    const videoIndex = thumbnail.getAttribute('data-videoindex');
    const videoSrc = thumbnail.getAttribute('data-videosrc');

    if (!videoSrc) {
        try {
            const response = await fetch(`getMT.php?id=${rowId}&videoIndex=${videoIndex}`);
            const fileData = await response.json();

            if (fileData.success) {
                const videoCenter = fileData.m_file;
                const post_processed = fileData.post_processed;
                const srt_nederlands = fileData.srt_nederlands;
                const srt_signbank_id_glossen = fileData.srt_signbank_id_glossen;
                const srt_gebaar_voor_gebaar = fileData.srt_gebaar_voor_gebaar;

                let videoPath;
                if (post_processed === "1") {
                    videoPath = `https://signcollect.nl/gebarenoverleg_media/studioFilesMini/post/${videoCenter.replace('.wav', '.mp4')}`;
                } else {
                    videoPath = `https://signcollect.nl/gebarenoverleg_media/studioFilesMini/raw/${videoCenter.replace('.wav', '.mp4')}`;
                }

                // Set video source
                thumbnail.setAttribute('data-videosrc', videoPath);

                // Create video element
                const videoId = `video-${rowId}-${videoIndex}`;
                const videoElement = document.createElement('video');
                videoElement.id = videoId;
                videoElement.className = 'portrait-video';
                videoElement.muted = true;
                videoElement.setAttribute('data-id', rowId);
                videoElement.setAttribute('data-videoindex', videoIndex);
                videoElement.autoplay = true;
                videoElement.loop = true;
                videoElement.playsInline = true;

                const source = document.createElement('source');
                source.src = videoPath;
                source.type = 'video/mp4'; // Adjust based on your video format
                videoElement.appendChild(source);

                // Add error handler for post-to-raw fallback
                videoElement.addEventListener('error', function() {
                    if (source.src.includes('/post/')) {
                        console.log(`Video 404 in post directory, trying raw: ${source.src}`);
                        source.src = getPostToRawFallback(source.src);
                        this.load(); // Reload video with new source
                    }
                });

                // Replace the thumbnail with the video
                thumbnail.replaceWith(videoElement);

                // Fetch the video container to access subtitle divs
                const videoContainer = document.getElementById(`videoContainer-${rowId}-${videoIndex}`);

                const subArray = [srt_nederlands, srt_signbank_id_glossen, srt_gebaar_voor_gebaar];

                // Load all subtitles concurrently
                const subtitlePromises = subArray.map(async (srtPath) => {
                    if (srtPath) {
                        var subtitleType = srtPath.split('_').slice(-1)[0];
                        //remove extension from subtitletype
                        subtitleType = subtitleType.split('.').slice(0, -1)[0];
                        const subtitleDiv = videoContainer.querySelector(`.subtitle.${subtitleType}`);
                        // console.log(subtitleType);
                        if (subtitleDiv) {
                            const srtUrl = srtPath;
                            const subtitleTextSpan = subtitleDiv.querySelector('.subtitle-text');
                            const subtitles = await loadSRT(srtUrl);
                            if (subtitles.length > 0) {
                                synchronizeSubtitles(videoElement, subtitles, subtitleTextSpan);
                            }
                        } else {
                            console.warn(`Subtitle div not found for ${srtPath}`);
                        }
                    }
                });

                await Promise.all(subtitlePromises);
            } else {
                console.error('Failed to fetch video data:', fileData.error);
            }
        } catch (error) {
            console.error('Error fetching video data:', error);
        }
    } else {
        // Play the video if already loaded
        const videoElement = document.getElementById(`video-${rowId}-${videoIndex}`);
        if (videoElement) {
            videoElement.play();
        }
    }
}

function handleVideoMouseLeave(videoElement) {
    const rowId = videoElement.getAttribute('data-id');
    const videoIndex = videoElement.getAttribute('data-videoindex');
    const videoSrc = videoElement.getAttribute('data-videosrc') || videoElement.querySelector('source').src;
    let thumbnailPath = videoSrc.replace('.mp4', '.jpg');

    // Pause and reset the video
    videoElement.pause();
    videoElement.currentTime = 0;

    // Create a new thumbnail image
    const thumbnail = document.createElement('img');
    thumbnail.src = thumbnailPath;
    thumbnail.alt = 'Video Thumbnail';
    thumbnail.className = 'portrait-thumbnail';
    thumbnail.setAttribute('data-id', rowId);
    thumbnail.setAttribute('data-videoindex', videoIndex);
    thumbnail.setAttribute('data-thumbnail', thumbnailPath);
    thumbnail.style.width = '200px';
    thumbnail.style.height = '300px';
    thumbnail.style.objectFit = 'cover';
    thumbnail.style.cursor = 'pointer';

    // Add error handler for post-to-raw fallback
    thumbnail.onerror = function() {
        if(this.src.includes('/post/')) {
            console.log('Thumbnail 404, trying raw:', this.src);
            this.src = this.src.replace('/post/', '/raw/');
        }
    };

    // Replace the video with the thumbnail
    videoElement.replaceWith(thumbnail);
}

function handleThumbnailClick(thumbnail) {
    const rowId = thumbnail.getAttribute('data-id');
    const videoIndex = thumbnail.getAttribute('data-videoindex');
    const videoSrc = thumbnail.getAttribute('data-videosrc');

    if (videoSrc) {
        openVideoModal(rowId, videoSrc);
    }
}

function openVideoModal(videoId, videoSrc) {
    // Optional: Implement a different modal or lightbox if needed
    // For now, open the video in a new tab
    window.open(videoSrc, '_blank');
}

async function duplicateRow(rowId, videoIndex, filename, buttonElement) {
    // console.log('duplicateRow called with:', rowId, videoIndex, filename);
    try {
        const fileResponse = await fetch(`getMT.php?id=${rowId}&videoIndex=${videoIndex}`);
        const fileData = await fileResponse.json();

        if (fileData.success) {
            let videoCenter = fileData.m_file;

            // Replace .mp4 with .wav if necessary
            videoCenter = videoCenter.replace(".mp4", ".wav");

            // Send a request to duplicate the row and move the video
            // console.log('Duplicating row:', rowId, videoIndex, videoCenter);
            const duplicateResponse = await fetch(`getZinnen.php?action=duplicate&rowId=${rowId}&videoCenter=${encodeURIComponent(videoCenter)}`, {
                method: 'GET'
            });
            const duplicateData = await duplicateResponse.json();

            if (duplicateData.success) {
                const newRowId = duplicateData.newRowId;
                // Fetch the new row data from the backend to get the updated sentence
                // console.log(newRowId);
                const fetchRowResponse = await fetch(`getZinnen.php?action=fetchRow&rowId=${newRowId}`);
                const newRowData = await fetchRowResponse.json();

                if (newRowData.success) {
                    appendNewRow(newRowData.row, rowId);
                    hideOriginalVideo(rowId, videoIndex);
                } else {
                    console.error('Failed to fetch new row data:', newRowData.error);
                }
            } else {
                console.error('Failed to duplicate row:', duplicateData.error);
            }
        } else {
            console.error('Failed to get video center:', fileData.error);
        }
    } catch (error) {
        console.error('Error duplicating row:', error);
    }
}

function appendNewRow(row, originalRowId) {
    let videosHTML = '';
    row.videos.forEach((video, videoIndex) => {
        const thumbnailPath = "https://signcollect.nl/gebarenoverleg_media/studioFilesMini/raw/" + video.thumbnail;
        const eafClass = video.eaf ? 'eaf-present' : '';

        // Check for subtitle files
        let srt_nederlands = video.srt_nederlands;
        let srt_signbank_id_glossen = video.srt_signbank_id_glossen;
        let srt_gebaar_voor_gebaar = video.srt_gebaar_voor_gebaar;

        // Initialize subtitleDivs as an empty string
        let subtitleDivs = '';

        if (srt_nederlands) {
            subtitleDivs += `
                <div class="subtitle srt_nederlands ${srt_nederlands.split('/').pop().split('.')[0]}">
                    <span class="subtitle-text"></span>
                </div>
            `;
        }

        if (srt_signbank_id_glossen) {
            subtitleDivs += `
                <div class="subtitle srt_signbank_id_glossen ${srt_signbank_id_glossen.split('/').pop().split('.')[0]}">
                    <span class="subtitle-text"></span>
                </div>
            `;
        }

        if (srt_gebaar_voor_gebaar) {
            subtitleDivs += `
                <div class="subtitle srt_gebaar_voor_gebaar ${srt_gebaar_voor_gebaar.split('/').pop().split('.')[0]}">
                    <span class="subtitle-text"></span>
                </div>
            `;
        }

        videosHTML += `
            <div class="video-container mb-2 ${eafClass}" id="videoContainer-${row.ID}-${videoIndex}" data-filename="${video.m_file}" style="position: relative;">
                <img 
                    src="${thumbnailPath}" 
                    alt="Video Thumbnail" 
                    class="portrait-thumbnail" 
                    data-id="${row.ID}" 
                    data-videoindex="${videoIndex}" 
                    data-thumbnail="${thumbnailPath}"
                    data-filename="${video.m_file}"
                    style="width:200px; height:300px; object-fit:cover; cursor:pointer;"
                >
                <!-- Subtitle Divs -->
                ${subtitleDivs}
                <!-- Action Buttons -->
                <div class="video-buttons mt-2">
                    <button class="btn btn-sm btn-secondary duplicate-btn" data-id="${row.ID}" data-videoindex="${videoIndex}" data-filename="${video.m_file}">Duplicate</button>
                    <button class="btn btn-sm btn-primary downloadEAF-btn" data-filename="${video.m_file}" data-post-processed="${video.post_processed}">Download EAF</button>
                    <button class="btn btn-sm btn-success downloadMP4-btn" data-filename="${video.m_file}" data-post-processed="${video.post_processed}">Download</button>
                    <button class="btn btn-sm btn-warning uploadEAF-btn" data-filename="${video.m_file}">Upload EAF</button>
                    <button class="btn btn-sm btn-danger delete-btn" data-id="${row.ID}" data-videoindex="${videoIndex}" data-filename="${video.m_file}">Delete video</button>
                    <!-- Delete EAF Button -->
                    <button class="btn btn-sm btn-outline-danger deleteEAF-btn" data-id="${row.ID}" data-videoindex="${videoIndex}" data-filename="${video.m_file}" ${!video.eaf ? 'disabled' : ''}>
                        <i class="fas fa-trash-alt"></i> Delete EAF
                    </button>
                </div>
            </div>
        `;
    });

    const sanitizedZin = sanitizeHTML(row.zinArray.join(' '));
    const newRowHTML = `
        <div class="bootstrap-grid" data-row-id="${row.ID}">
            <div class="sentence-text">
                <input type="text" class="zin-input form-control" value="${sanitizedZin}" data-id="${row.ID}">
                <!-- Comments Field -->
                <textarea class="form-control comments-field" placeholder="Add comments..." data-id="${row.ID}">${row.comments || ''}</textarea>
                <!-- Status Select Menus -->
                <div class="d-flex flex-column gap-2 mt-2">
                    <div class="d-flex align-items-center">
                        <label class="me-2">Status Video Controle:</label>
                        <select class="form-select status-video-select" data-id="${row.ID}">
                            <option value="" ${row.status_video === '' ? 'selected' : ''}>Leeg/Empty</option>
                            <option value="Niet Klaar" ${row.status_video === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                            <option value="Klaar" ${row.status_video === 'Klaar' ? 'selected' : ''}>Klaar</option>
                            <option value="signbank" ${row.status_video === 'signbank' ? 'selected' : ''}>Niet voor app, verplaatsen naar Signbank</option>
                        </select>
                    </div>
                    <div class="d-flex align-items-center">
                        <label class="me-2">Status Nederlands:</label>
                        <select class="form-select status-annotatie-select" data-id="${row.ID}">
                            <option value="" ${row.status_annotatie === '' ? 'selected' : ''}>Leeg/Empty</option>
                            <option value="Niet Klaar" ${row.status_annotatie === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                            <option value="Klaar" ${row.status_annotatie === 'Klaar' ? 'selected' : ''}>Klaar</option>
                            <option value="Controle nodig" ${row.status_annotatie === 'Controle nodig' ? 'selected' : ''}>Controle nodig</option>
                        </select>
                    </div>
                    <div class="d-flex align-items-center">
                        <label class="me-2">Status Glossen:</label>
                        <select class="form-select status-glos-select" data-id="${row.ID}">
                            <option value="" ${row.status_glos === '' ? 'selected' : ''}>Leeg/Empty</option>
                            <option value="Niet Klaar" ${row.status_glos === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                            <option value="Klaar" ${row.status_glos === 'Klaar' ? 'selected' : ''}>Klaar</option>
                            <option value="NVT" ${row.status_glos === 'NVT' ? 'selected' : ''}>NVT</option>
                        </select>
                    </div>
                    <div class="d-flex align-items-center">
                        <label class="me-2">Status Gebaar voor Gebaar:</label>
                        <select class="form-select status-gvg-select" data-id="${row.ID}">
                            <option value="" ${row.status_gvg === '' ? 'selected' : ''}>Leeg/Empty</option>
                            <option value="Niet Klaar" ${row.status_gvg === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                            <option value="Klaar" ${row.status_gvg === 'Klaar' ? 'selected' : ''}>Klaar</option>
                            <option value="Check nodig" ${row.status_gvg === 'Check nodig' ? 'selected' : ''}>Check nodig</option>
                        </select>
                    </div>

                    <div class="d-flex align-items-center">
                        <label class="me-2">MCP - Status Postprocessing:</label>
                        <select class="form-select mcp-status-postprocessing-select" data-id="${row.ID}">
                            <option value="" ${row.mcp_status_postprocessing === '' || row.mcp_status_postprocessing === null ? 'selected' : ''}>Leeg/Empty</option>
                            <option value="Niet Klaar" ${row.mcp_status_postprocessing === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                            <option value="Klaar" ${row.mcp_status_postprocessing === 'Klaar' ? 'selected' : ''}>Klaar</option>
                            <option value="Check nodig" ${row.mcp_status_postprocessing === 'Check nodig' ? 'selected' : ''}>Check nodig</option>
                        </select>
                    </div>

                    <div class="d-flex align-items-center">
                        <label class="me-2">MCP - Status Tijd Annotatie Gloss:</label>
                        <select class="form-select mcp-status-tijd-annotatie-select" data-id="${row.ID}">
                            <option value="" ${row.mcp_status_tijd_annotatie === '' || row.mcp_status_tijd_annotatie === null ? 'selected' : ''}>Leeg/Empty</option>
                            <option value="Niet Klaar" ${row.mcp_status_tijd_annotatie === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                            <option value="Klaar" ${row.mcp_status_tijd_annotatie === 'Klaar' ? 'selected' : ''}>Klaar</option>
                            <option value="Check nodig" ${row.mcp_status_tijd_annotatie === 'Check nodig' ? 'selected' : ''}>Check nodig</option>
                        </select>
                    </div>

                    <div class="d-flex align-items-center">
                        <label class="me-2">MCP - Status Tijd annotatie Gebaar voor Gebaar/Nederlands:</label>
                        <select class="form-select mcp-status-tijd-annotatie-gvg-select" data-id="${row.ID}">
                            <option value="" ${row.mcp_status_tijd_annotatie_gvg === '' || row.mcp_status_tijd_annotatie_gvg === null ? 'selected' : ''}>Leeg/Empty</option>
                            <option value="Niet Klaar" ${row.mcp_status_tijd_annotatie_gvg === 'Niet Klaar' ? 'selected' : ''}>Niet Klaar</option>
                            <option value="Klaar" ${row.mcp_status_tijd_annotatie_gvg === 'Klaar' ? 'selected' : ''}>Klaar</option>
                            <option value="Check nodig" ${row.mcp_status_tijd_annotatie_gvg === 'Check nodig' ? 'selected' : ''}>Check nodig</option>
                        </select>
                    </div>
                </div>
                <!-- View Videos Button -->
                <button class="btn btn-sm btn-info mt-2 view-videos-btn" data-row-id="${row.ID}">View Videos</button>
                <button class="btn btn-sm btn-info mt-2 delete-zin-btn" data-row-id="${row.ID}">Delete Sentence</button>

            </div>
            <div class="video-column">
                ${videosHTML}
            </div>
        </div>
    `;

    const originalRowElement = document.querySelector(`.bootstrap-grid[data-row-id="${originalRowId}"]`);
    if (originalRowElement) {
        originalRowElement.insertAdjacentHTML('afterend', newRowHTML);
        // console.log('Appended new row:', row.ID);
    } else {
        // Fallback to appending at the end if original row not found
        const tableContainer = document.getElementById('tableContainer');
        tableContainer.insertAdjacentHTML('beforeend', newRowHTML);
        // console.log('Appended new row at the end:', row.ID);
    }

    // No need to reattach event listeners due to event delegation
}

function hideOriginalVideo(originalRowId, videoIndex) {
    const originalVideoContainer = document.getElementById(`videoContainer-${originalRowId}-${videoIndex}`);
    if (originalVideoContainer) {
        originalVideoContainer.style.display = 'none';
        // console.log(`Hid original video container: videoContainer-${originalRowId}-${videoIndex}`);
    } else {
        console.error('Original video container not found to hide.');
    }
}

function addZinInputEventListeners() {
    const container = document.getElementById('tableContainer');

    container.addEventListener('blur', function(e) {
        if (e.target && e.target.classList.contains('zin-input')) {
            const input = e.target;
            const rowId = input.getAttribute('data-id');
            const newZin = input.value;
            editZin(rowId, newZin);
        }
    }, true);
}


    // also trigger change from searchgloss
    document.getElementById('searchGloss').addEventListener('input', debounce(function(e) {
        searchGloss = this.value.trim();
        currentPage = 1; // Reset to first page
        saveCurrentState();
        loadSentences(currentPage, currentThema, searchQuery, statusVideoFilter,
                      statusAnnotatieFilter, statusGlosFilter, statusGvgFilter,
                      mcpStatusPostprocessingFilter, mcpStatusTijdAnnotatieFilter,
                      motionCaptureFilter, searchGloss, searchGVG,
                      mcpStatusTijdAnnotatieGvgFilter);
    }, 500)); // Adjust debounce delay as needed

    // Add event listener for GVG search
    document.getElementById('searchGVG').addEventListener('input', debounce(function(e) {
        searchGVG = this.value.trim();
        currentPage = 1; // Reset to first page
        saveCurrentState();
        loadSentences(currentPage, currentThema, searchQuery, statusVideoFilter,
                      statusAnnotatieFilter, statusGlosFilter, statusGvgFilter,
                      mcpStatusPostprocessingFilter, mcpStatusTijdAnnotatieFilter,
                      motionCaptureFilter, searchGloss, searchGVG,
                      mcpStatusTijdAnnotatieGvgFilter);
    }, 500)); // Adjust debounce delay as needed


    // Apply Global Status to All Videos of Selected Thema
    document.addEventListener('DOMContentLoaded', function() {
        const applyBtn = document.getElementById('applyGlobalStatusBtn');
        if (applyBtn) {
            applyBtn.addEventListener('click', function() {
        const selectedThema = document.getElementById('themaFilter').value;
        const selectedStatus = document.getElementById('globalStatusSelect').value;

        if (!selectedThema) {
            alert('Please select a thema to apply the status.');
            return;
        }

        if (!selectedStatus) {
            alert('Please select a status to apply.');
            return;
        }

        // Confirm action
        if (!confirm(`Are you sure you want to set the status to "${selectedStatus}" for all videos under the thema "${selectedThema}"?`)) {
            return;
        }

        // Send request to backend to update status for all rows under the selected thema
        fetch('getZinnen.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `action=updateStatusForThema&thema=${encodeURIComponent(selectedThema)}&status=${encodeURIComponent(selectedStatus)}`
        })
        .then(response => response.json())
        .then(data => {
            // console.log(data, selectedStatus, selectedThema)
            if (data.success) {
                // console.log(`Status "${selectedStatus}" applied to all videos under thema "${selectedThema}".`);
                alert(`Status "${selectedStatus}" applied to all videos under thema "${selectedThema}".`);
                // Optionally, reload the current page to reflect changes
                loadSentences(currentPage, currentThema, searchQuery, statusVideoFilter,
                      statusAnnotatieFilter, statusGlosFilter, statusGvgFilter,
                      mcpStatusPostprocessingFilter, mcpStatusTijdAnnotatieFilter,
                      motionCaptureFilter, searchGloss, searchGVG,
                      mcpStatusTijdAnnotatieGvgFilter);
            } else {
                console.error('Failed to apply global status:', data.error);
                alert('Failed to apply global status: ' + data.error);
            }
        })
        .catch(error => {
            console.error('Error applying global status:', error);
            alert('An error occurred while applying the global status.');
        });
            });
        }
    });
}, 3000);



    // Add state saving functionality
    function saveCurrentState() {
        // Capture the current values directly from the UI elements to ensure accuracy
        const state = {
            currentPage: currentPage,
            currentThema: document.getElementById('themaFilter').value,
            searchQuery: document.getElementById('searchBar').value,
            searchGloss: document.getElementById('searchGloss').value,
            searchGVG: document.getElementById('searchGVG').value,
            statusVideoFilter: document.getElementById('statusVideoFilter').value,
            statusAnnotatieFilter: document.getElementById('statusAnnotatieFilter').value,
            statusGlosFilter: document.getElementById('statusGlosFilter').value,
            statusGvgFilter: document.getElementById('statusGvgFilter').value,
            motionCaptureFilter: document.getElementById('motionCaptureFilter').value,
            mcpStatusPostprocessingFilter: document.getElementById('mcpStatusPostprocessingFilter').value,
            mcpStatusTijdAnnotatieFilter: document.getElementById('mcpStatusTijdAnnotatieFilter').value,
            mcpStatusTijdAnnotatieGvgFilter: document.getElementById('mcpStatusTijdAnnotatieGvgFilter').value,
            scrollPosition: window.scrollY,
            timestamp: new Date().getTime()
        };

        console.log("Saving state:", state); // Add debugging to check what's being saved
        localStorage.setItem('zinnen_state', JSON.stringify(state));
    }

    // Modify the restoreState function to log the retrieved state for debugging
    function restoreState() {
        const storedState = localStorage.getItem('zinnen_state');
        if (storedState) {
            try {
                const state = JSON.parse(storedState);
                console.log("Restoring state:", state); // Add debugging to see what was retrieved

                    // Restore filter values in the UI
                    document.getElementById('themaFilter').value = state.currentThema || '';
                    console.log("Restoring themaFilter:", state.currentThema);

                    //get list from themaFilter select menu id
                    const themaFilter = document.getElementById('themaFilter');
                    const options = themaFilter.options;
                    for (let i = 0; i < options.length; i++) {
                        if (options[i].value === state.currentThema) {
                            options[i].selected = true;
                            break;
                        }
                    }
                    console.log(options)

                    document.getElementById('searchBar').value = state.searchQuery || '';
                    document.getElementById('searchGloss').value = state.searchGloss || '';
                    document.getElementById('searchGVG').value = state.searchGVG || '';
                    
                    // For status filters, explicitly check if the value exists in state
                    // and if it's undefined/null use empty string
                    document.getElementById('statusVideoFilter').value =
                        state.hasOwnProperty('statusVideoFilter') ? state.statusVideoFilter : '';
                    document.getElementById('statusAnnotatieFilter').value =
                        state.hasOwnProperty('statusAnnotatieFilter') ? state.statusAnnotatieFilter : '';
                    document.getElementById('statusGlosFilter').value =
                        state.hasOwnProperty('statusGlosFilter') ? state.statusGlosFilter : '';
                    document.getElementById('statusGvgFilter').value =
                        state.hasOwnProperty('statusGvgFilter') ? state.statusGvgFilter : '';
                    document.getElementById('motionCaptureFilter').value =
                        state.hasOwnProperty('motionCaptureFilter') ? state.motionCaptureFilter : '';
                    document.getElementById('mcpStatusPostprocessingFilter').value =
                        state.hasOwnProperty('mcpStatusPostprocessingFilter') ? state.mcpStatusPostprocessingFilter : '';
                    document.getElementById('mcpStatusTijdAnnotatieFilter').value =
                        state.hasOwnProperty('mcpStatusTijdAnnotatieFilter') ? state.mcpStatusTijdAnnotatieFilter : '';
                    document.getElementById('mcpStatusTijdAnnotatieGvgFilter').value =
                        state.hasOwnProperty('mcpStatusTijdAnnotatieGvgFilter') ? state.mcpStatusTijdAnnotatieGvgFilter : '';

                    // Restore global variables
                    currentPage = state.currentPage || 1;
                    currentThema = state.currentThema || "";
                    searchQuery = state.searchQuery || "";
                    searchGloss = state.searchGloss || "";
                    searchGVG = state.searchGVG || "";

                    // Use the same approach with explicit property checks for global variables
                    statusVideoFilter = state.hasOwnProperty('statusVideoFilter') ? state.statusVideoFilter : "";
                    statusAnnotatieFilter = state.hasOwnProperty('statusAnnotatieFilter') ? state.statusAnnotatieFilter : "";
                    statusGlosFilter = state.hasOwnProperty('statusGlosFilter') ? state.statusGlosFilter : "";
                    statusGvgFilter = state.hasOwnProperty('statusGvgFilter') ? state.statusGvgFilter : "";
                    motionCaptureFilter = state.hasOwnProperty('motionCaptureFilter') ? state.motionCaptureFilter : "";
                    mcpStatusPostprocessingFilter = state.hasOwnProperty('mcpStatusPostprocessingFilter') ? state.mcpStatusPostprocessingFilter : "";
                    mcpStatusTijdAnnotatieFilter = state.hasOwnProperty('mcpStatusTijdAnnotatieFilter') ? state.mcpStatusTijdAnnotatieFilter : "";
                    mcpStatusTijdAnnotatieGvgFilter = state.hasOwnProperty('mcpStatusTijdAnnotatieGvgFilter') ? state.mcpStatusTijdAnnotatieGvgFilter : "";


                    console.log("After restoration - searchQuery:", searchQuery);
                    console.log("searchBar value:", document.getElementById('searchBar').value);
                    
                    // Load sentences with restored state
                    loadSentences(
                        currentPage,
                        currentThema,
                        searchQuery,
                        statusVideoFilter,
                        statusAnnotatieFilter,
                        statusGlosFilter,
                        statusGvgFilter,
                        mcpStatusPostprocessingFilter,
                        mcpStatusTijdAnnotatieFilter,
                        motionCaptureFilter,
                        searchGloss,
                        searchGVG,
                        mcpStatusTijdAnnotatieGvgFilter
                    ).then(() => {
                        // After loading, restore scroll position
                        if (state.scrollPosition) {
                            setTimeout(() => {
                                window.scrollTo(0, state.scrollPosition);
                            }, 200); // Small delay to ensure content is rendered
                        }
                    });
                    
                    return true; // State was successfully restored
                
            } catch (e) {
                console.error('Error restoring state:', e);
            }
        }
        return false; // State was not restored
    }

    // Check if we're returning from subBeta.html
    const editedFile = urlParams.get('edited');

    setTimeout(() => {

//set timeout of 500ms here
const stateRestored = restoreState();
        if (!stateRestored) {
            // If state restoration failed, load with default state
            const urlSearchGloss = urlParams.get('searchGloss') || "";
            const urlSearchGVG = urlParams.get('searchGVG') || "";
            searchGloss = urlSearchGloss; // Set the global variable
            searchGVG = urlSearchGVG; // Set the global variable
            if (urlSearchGloss) {
                document.getElementById('searchGloss').value = urlSearchGloss; // Update the UI element
            }
            if (urlSearchGVG) {
                document.getElementById('searchGVG').value = urlSearchGVG; // Update the UI element
            }
            
            loadSentences(
                1,
                '',
                "",
                statusVideoFilter,
                statusAnnotatieFilter,
                statusGlosFilter,
                statusGvgFilter,
                mcpStatusPostprocessingFilter,
                mcpStatusTijdAnnotatieFilter,
                motionCaptureFilter,
                searchGloss,
                searchGVG,
                mcpStatusTijdAnnotatieGvgFilter
            );
        }
        
        // Clear the edited parameter from URL to avoid confusion on refresh
        if (editedFile) {
            const newUrl = window.location.pathname;
            history.replaceState(null, '', newUrl);
        }
    }, 500);


    // Modify the existing editEAF-btn click handler to preserve state in the URL
    document.body.addEventListener('click', function(e) {
        if (e.target && e.target.classList.contains('editEAF-btn')) {
            saveCurrentState();
        }
    });

    // Make sure state is saved more frequently - not just on beforeunload
    // Add event listeners to save the state when values change
    document.getElementById('searchBar').addEventListener('input', debounce(function() {
        searchQuery = this.value.trim();
        saveCurrentState();
    }, 500));

    document.getElementById('searchGloss').addEventListener('input', debounce(function() {
        searchGloss = this.value.trim();
        saveCurrentState();
    }, 500));

    document.getElementById('themaFilter').addEventListener('change', function() {
        currentThema = this.value;
        saveCurrentState();
    });

    document.getElementById('statusVideoFilter').addEventListener('change', function() {
        statusVideoFilter = this.value;
        saveCurrentState();
    });

    document.getElementById('statusAnnotatieFilter').addEventListener('change', function() {
        statusAnnotatieFilter = this.value;
        saveCurrentState();
    });

    document.getElementById('statusGlosFilter').addEventListener('change', function() {
        statusGlosFilter = this.value;
        saveCurrentState();
    });

    document.getElementById('statusGvgFilter').addEventListener('change', function() {
        statusGvgFilter = this.value;
        saveCurrentState();
    });

    // Also save the state when navigating to subBeta.html
    document.addEventListener('click', function(e) {
        if (e.target && e.target.classList.contains('editEAF-btn')) {
            saveCurrentState();
            console.log("State saved before navigating to subBeta2.html");
        }
    });

})();

    </script>

</body>
</html>

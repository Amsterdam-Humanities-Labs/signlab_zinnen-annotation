            <button type="button" class="btn btn-danger" id="confirmDeleteEAFBtn">Delete EAF</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Video Display Modal -->
    <div class="modal fade" id="videoDisplayModal" tabindex="-1" aria-labelledby="videoDisplayModalLabel" aria-hidden="true">

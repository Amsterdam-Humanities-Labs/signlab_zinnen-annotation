// Add "Play All" button to the video modal
function addPlayAllButton() {
    const existingButton = document.getElementById('playAllVideosBtn');
    if (!existingButton) {
        const playAllButton = document.createElement('button');
        playAllButton.id = 'playAllVideosBtn';
        playAllButton.className = 'btn btn-success mb-3';
        playAllButton.textContent = 'Play All Videos';

        playAllButton.addEventListener('click', () => {
            const videos = document.querySelectorAll('#videosContainer video');
            videos.forEach(video => video.play());
        });

        const videoModalBody = document.querySelector('#videoDisplayModal .modal-body');
        videoModalBody.insertBefore(playAllButton, document.getElementById('videosContainer'));
    }
}


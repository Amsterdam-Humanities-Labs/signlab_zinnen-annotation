<!-- Logs Display Modal -->
<div class="modal fade" id="logsDisplayModal" tabindex="-1" aria-labelledby="logsDisplayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl"> <!-- Use 'modal-xl' for a larger modal -->
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Action Logs</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Filters for Logs -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label for="logActionFilter" class="form-label">Action:</label>
                        <input type="text" id="logActionFilter" class="form-control" placeholder="Filter by action">
                    </div>
                    <div class="col-md-3">
                        <label for="logDateFrom" class="form-label">Date From:</label>
                        <input type="date" id="logDateFrom" class="form-control">
                    </div>
                    <div class="col-md-3">
                        <label for="logDateTo" class="form-label">Date To:</label>
                        <input type="date" id="logDateTo" class="form-control">
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary w-100" id="applyLogFiltersBtn">Apply Filters</button>
                    </div>
                </div>

                <!-- Logs Table -->
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="logsTable">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Action</th>
                                <th>Parameters</th>
                                <th>IP Address</th>
                                <th>Date & Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Logs will be populated here dynamically -->
                        </tbody>
                    </table>
                </div>

                <!-- Pagination for Logs -->
                <nav aria-label="Log pagination">
                    <ul class="pagination justify-content-center" id="logsPagination">
                        <!-- Pagination items will be dynamically inserted here -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- NEW: Duplicate Confirmation Modal -->
<div class="modal fade" id="duplicateConfirmationModal" tabindex="-1" aria-labelledby="duplicateConfirmationModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="duplicateConfirmationModalLabel">Confirm Duplicate</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Are you sure you want to move this video to a new sentence?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="confirmDuplicateBtn">Confirm</button>
      </div>
    </div>
  </div>
</div>

    <script>
        // Utility Functions - defined early to be available for other functions
        function sanitizeHTML(str) {
            var temp = document.createElement('div');
            temp.textContent = str;
            return temp.innerHTML;
        }

        // Fallback function for switching from post to raw directory
        function getPostToRawFallback(url) {
            return url.replace('/post/', '/raw/');
        }

        // Video Management Functions - defined early to be available for onclick handlers
        function restoreVideo(videoId) {
            const formData = new FormData();
            formData.append('videoId', videoId);
            
            fetch('getZinnen.php?action=restoreVideo', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update the modal UI immediately - find the video container and update buttons
                    const videoContainers = document.querySelectorAll('#videosContainer > div');
                    videoContainers.forEach(container => {
                        const restoreButton = container.querySelector(`button[onclick="restoreVideo(${videoId})"]`);
                        if (restoreButton) {
                            // Update status badge
                            const statusBadge = container.querySelector('.badge');
                            if (statusBadge) {
                                statusBadge.className = 'badge bg-success mb-2';
                                statusBadge.textContent = 'Active';
                            }
                            
                            // Restore video opacity
                            const video = container.querySelector('video');
                            if (video) {
                                video.style.opacity = '1';
                            }
                            
                            // Remove container opacity
                            container.classList.remove('opacity-75');
                            
                            // Replace buttons
                            const buttonContainer = container.querySelector('div:last-child');
                            if (buttonContainer) {
                                buttonContainer.innerHTML = `
                                    <button class="btn btn-sm btn-warning" onclick="deleteVideo(${videoId})" title="Delete Video">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                `;
                            }
                        }
                    });
                    
                    // Update the main page row video column for the specific restored video
                    const currentRowId = document.querySelector('.modal.show')?.getAttribute('data-row-id');
                    if (currentRowId) {
                        const rowElement = document.querySelector(`.bootstrap-grid[data-row-id="${currentRowId}"]`);
                        if (rowElement) {
                            const videoColumn = rowElement.querySelector('.video-column');
                            if (videoColumn) {
                                const videoContainers = videoColumn.querySelectorAll('.video-container');
                                
                                // If no video containers exist, refresh the entire video column
                                if (videoContainers.length === 0) {
                                    refreshRowVideoColumn(currentRowId);
                                } else {
                                    // Update existing video containers to show active state
                                    videoContainers.forEach(container => {
                                        const thumbnail = container.querySelector('.portrait-thumbnail');
                                        if (thumbnail) {
                                            // Restore original appearance
                                            thumbnail.style.opacity = '1';
                                            thumbnail.style.filter = 'none';
                                            
                                            // Remove deleted badge if present
                                            const deletedBadge = container.querySelector('.deleted-badge');
                                            if (deletedBadge) {
                                                deletedBadge.remove();
                                            }
                                            
                                            // Add an active badge temporarily to show it was restored
                                            let activeBadge = container.querySelector('.active-badge');
                                            if (!activeBadge) {
                                                activeBadge = document.createElement('span');
                                                activeBadge.className = 'badge bg-success active-badge position-absolute top-0 start-0 m-1';
                                                activeBadge.textContent = 'Active';
                                                activeBadge.style.zIndex = '10';
                                                container.style.position = 'relative';
                                                container.appendChild(activeBadge);
                                                
                                                // Remove the active badge after 3 seconds
                                                setTimeout(() => {
                                                    if (activeBadge && activeBadge.parentNode) {
                                                        activeBadge.remove();
                                                    }
                                                }, 3000);
                                            }
                                        }
                                    });
                                }
                            }
                        }
                    }
                } else {
                    console.error('Failed to restore video:', data.error);
                }
            })
            .catch(error => {
                console.error('Error restoring video:', error);
            });
        }

        // Function to refresh a specific row's video column
        async function refreshRowVideoColumn(rowId) {
            try {
                const rowElement = document.querySelector(`.bootstrap-grid[data-row-id="${rowId}"]`);
                if (!rowElement) return;

                const videoColumn = rowElement.querySelector('.video-column');
                if (!videoColumn) return;

                // Fetch updated video data for this row using the same API as the modal
                const response = await fetch(`getZinnen.php?action=fetchVideos&rowId=${rowId}&includeDeleted=false`);
                const data = await response.json();
                
                if (data.success && data.videos) {
                    let videosHTML = '';
                    
                    // Rebuild video thumbnails HTML for active M videos only
                    data.videos.forEach((video, videoIndex) => {
                        if (video && video.m_file && video.added == 1) { // Only show active M videos
                            // Generate thumbnail path
                            let thumbnailPath;
                            if (video.post_processed === "1") {
                                thumbnailPath = `https://signcollect.nl/gebarenoverleg_media/studioFilesMini/post/${video.m_file.replace('.wav', '.jpg')}`;
                            } else {
                                thumbnailPath = `https://signcollect.nl/gebarenoverleg_media/studioFilesMini/raw/${video.m_file.replace('.wav', '.jpg')}`;
                            }
                            
                            const eafClass = video.eaf ? 'eaf-present' : '';
                            
                            videosHTML += `
                                <div class="video-container mb-2 ${eafClass}" id="videoContainer-${rowId}-${videoIndex}" data-filename="${video.m_file}" style="position: relative;">
                                    <img
                                        src="${thumbnailPath}"
                                        alt="Video Thumbnail"
                                        class="portrait-thumbnail"
                                        data-id="${rowId}"
                                        data-videoindex="${videoIndex}"
                                        data-thumbnail="${thumbnailPath}"
                                        data-filename="${video.m_file}"
                                        style="width:200px; height:300px; object-fit:cover; cursor:pointer;"
                                        onerror="if(this.src.includes('/post/')){console.log('Thumbnail 404, trying raw:',this.src);this.src=this.src.replace('/post/','/raw/');}"
                                    />
                                </div>
                            `;
                        }
                    });
                    
                    // Update the video column content
                    videoColumn.innerHTML = videosHTML;
                }
            } catch (error) {
                console.error('Error refreshing video column:', error);
            }
        }

        // Permanent delete functionality removed per user request - videos can always be restored

        function deleteVideo(videoId) {
            const formData = new FormData();
            formData.append('rowId', videoId);
            
            fetch('getZinnen.php?action=delete', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update the modal UI immediately - find the video container and update buttons
                    const videoContainers = document.querySelectorAll('#videosContainer > div');
                    videoContainers.forEach(container => {
                        const deleteButton = container.querySelector(`button[onclick="deleteVideo(${videoId})"]`);
                        if (deleteButton) {
                            // Update status badge
                            const statusBadge = container.querySelector('.badge');
                            if (statusBadge) {
                                statusBadge.className = 'badge bg-warning mb-2';
                                statusBadge.textContent = 'Deleted';
                            }
                            
                            // Update video opacity
                            const video = container.querySelector('video');
                            if (video) {
                                video.style.opacity = '0.7';
                            }
                            
                            // Update container opacity
                            container.classList.add('opacity-75');
                            
                            // Replace buttons
                            const buttonContainer = container.querySelector('div:last-child');
                            if (buttonContainer) {
                                buttonContainer.innerHTML = `
                                    <button class="btn btn-sm btn-success" onclick="restoreVideo(${videoId})" title="Restore Video">
                                        <i class="fas fa-undo"></i> Restore
                                    </button>
                                `;
                            }
                        }
                    });
                    
                    // Update the main page row video column for the specific deleted video
                    const currentRowId = document.querySelector('.modal.show')?.getAttribute('data-row-id');
                    if (currentRowId) {
                        // Refresh the video column to remove deleted videos from display
                        // This ensures that when all videos are deleted, the column is empty
                        // and will properly rebuild when videos are restored
                        refreshRowVideoColumn(currentRowId);
                    }
                } else {
                    console.error('Failed to delete video:', data.error);
                }
            })
            .catch(error => {
                console.error('Error deleting video:', error);
            });
        }

        // Function to View Videos in Modal - moved up for early availability
        function viewVideos(rowId) {
            // Fetch videos for the given rowId, including deleted ones
            fetch(`getZinnen.php?action=fetchVideos&rowId=${rowId}&includeDeleted=true`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const videos = data.videos;
                        const videosContainer = document.getElementById('videosContainer');
                        videosContainer.innerHTML = ''; // Clear previous videos
                        
                        // Filter to only show M videos and create display elements
                        videos.forEach(video => {
                            // Only process if there's an m_file
                            if (video.m_file) {
                                let videoPath;
                                if (video.post_processed === "1") {
                                    videoPath = `https://signcollect.nl/gebarenoverleg_media/studioFilesMini/post/${video.m_file.replace('.wav', '.mp4')}`;
                                } else {
                                    videoPath = `https://signcollect.nl/gebarenoverleg_media/studioFilesMini/raw/${video.m_file.replace('.wav', '.mp4')}`;
                                }

                                // Determine video status and styling
                                let statusBadge = '';
                                let actionButtons = '';
                                let containerClass = 'me-2 mb-2';
                                
                                if (video.added == 1) {
                                    statusBadge = '<span class="badge bg-success mb-2">Active</span>';
                                    actionButtons = `
                                        <button class="btn btn-sm btn-warning" onclick="deleteVideo(${video.video_id})" title="Delete Video">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    `;
                                } else {
                                    statusBadge = '<span class="badge bg-warning mb-2">Deleted</span>';
                                    containerClass += ' opacity-75';
                                    actionButtons = `
                                        <button class="btn btn-sm btn-success" onclick="restoreVideo(${video.video_id})" title="Restore Video">
                                            <i class="fas fa-undo"></i> Restore
                                        </button>
                                    `;
                                }

                                let videoElement = `
                                    <div class="${containerClass}" style="border: 1px solid #ddd; padding: 10px; border-radius: 5px;">
                                        ${statusBadge}
                                        <video width="300" height="450" controls ${video.added != 1 ? 'style="opacity: 0.7;"' : ''}>
                                            <source src="${videoPath}" type="video/mp4">
                                            Your browser does not support the video tag.
                                        </video>
                                        <p class="mt-2 mb-1"><strong>File:</strong> ${sanitizeHTML(video.m_file)}</p>
                                        <div class="mt-2">
                                            ${actionButtons}
                                        </div>
                                    </div>
                                `;
                                videosContainer.insertAdjacentHTML('beforeend', videoElement);
                            }
                        });

                        // Attach error handlers to newly added videos for post-to-raw fallback
                        videosContainer.querySelectorAll('video').forEach(video => {
                            video.addEventListener('error', function() {
                                const source = this.querySelector('source');
                                if (source && source.src.includes('/post/')) {
                                    console.log(`Video 404 in post directory, trying raw: ${source.src}`);
                                    source.src = getPostToRawFallback(source.src);
                                    this.load(); // Reload video with new source
                                }
                            });
                        });

                        // Show message if no M videos found
                        if (videosContainer.innerHTML === '') {
                            videosContainer.innerHTML = '<p class="text-muted">No M videos found for this sentence.</p>';
                        }

                        // Show the modal and store the rowId
                        const videoModalElement = document.getElementById('videoDisplayModal');
                        videoModalElement.setAttribute('data-row-id', rowId);
                        const videoModal = new bootstrap.Modal(videoModalElement);
                        videoModal.show();
                    } else {
                        console.error('Failed to fetch videos:', data.error);
                    }
                })
                .catch(error => {
                    console.error('Error fetching videos:', error);
                });
        }

      (async function() {

        
// Wait for DOM to be ready before attaching event listeners
document.addEventListener('DOMContentLoaded', function() {

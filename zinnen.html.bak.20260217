            deleteModal.hide();
        }
    }
});

/**
* Parse SRT data into an array of subtitle objects.
* @param {string} data - The raw SRT file content.
* @returns {Array} Array of subtitle objects with startTime, endTime, and text.
*/
function parseSRT(data) {
const srt = data.replace(/\r/g, '');
const regex = /(\d+)\n(\d{2}:\d{2}:\d{2},\d{3}) --> (\d{2}:\d{2}:\d{2},\d{3})\n([\s\S]*?)(?=\n\n|\n*$)/g;
const result = [];
let match;

while ((match = regex.exec(srt)) !== null) {
    result.push({
        index: parseInt(match[1], 10),
        startTime: toSeconds(match[2]),
        endTime: toSeconds(match[3]),
        text: match[4].replace('\n', '<br>')
    });
}

return result;
}

/**
* Convert time string to seconds.
* @param {string} time - Time in format "HH:MM:SS,mmm".
* @returns {number} Time in seconds.
*/
function toSeconds(time) {
const parts = time.split(':');
const secParts = parts[2].split(',');
return parseInt(parts[0], 10) * 3600 +
       parseInt(parts[1], 10) * 60 +
       parseFloat(secParts[0] + '.' + secParts[1]);
}

/**
* Load and parse an SRT file from a given URL.
* @param {string} url - The URL of the SRT file.
* @returns {Promise<Array>} Promise resolving to an array of subtitle objects.
*/
async function loadSRT(url) {
if (!url) return [];
try {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`Failed to load ${url}`);
    const text = await response.text();
    return parseSRT(text);
} catch (error) {
    console.error(error);
    return [];
}
}

/**
* Synchronize subtitles with video playback.
* @param {HTMLVideoElement} video - The video element.
* @param {Array} subtitles - Array of subtitle objects.
* @param {HTMLElement} subtitleDiv - The div to display subtitles.
*/
function synchronizeSubtitles(video, subtitles, subtitleDiv) {
// console.log(video,  subtitles, subtitleDiv);
video.addEventListener('timeupdate', () => {
    const currentTime = video.currentTime;
    const currentSubtitle = subtitles.find(sub => currentTime >= sub.startTime && currentTime <= sub.endTime);
    if (currentSubtitle) {
        subtitleDiv.innerHTML = currentSubtitle.text;
        subtitleDiv.style.display = 'block';
    } else {
        subtitleDiv.style.display = 'none';
    }
});

video.addEventListener('ended', () => {
    subtitleDiv.style.display = 'none';
});
}


function initializeLogsModal() {
        const viewLogsBtn = document.getElementById('viewLogsBtn');
        const logsDisplayModal = new bootstrap.Modal(document.getElementById('logsDisplayModal'));
        const logsTableBody = document.querySelector('#logsTable tbody');
        const logsPagination = document.getElementById('logsPagination');
        const applyLogFiltersBtn = document.getElementById('applyLogFiltersBtn');
        const logActionFilter = document.getElementById('logActionFilter');
        const logDateFrom = document.getElementById('logDateFrom');
        const logDateTo = document.getElementById('logDateTo');

        let currentLogPage = 1;
        let totalLogPages = 1;

        // Event listener to open the logs modal
        viewLogsBtn.addEventListener('click', function() {
            currentLogPage = 1; // Reset to first page
            fetchAndDisplayLogs(currentLogPage);
            logsDisplayModal.show();
        });

        // Event listener for applying log filters
        applyLogFiltersBtn.addEventListener('click', function() {
            currentLogPage = 1; // Reset to first page
            fetchAndDisplayLogs(currentLogPage);
        });

        // Function to fetch and display logs
        async function fetchAndDisplayLogs(page) {
            const actionFilter = logActionFilter.value.trim();
            const dateFrom = logDateFrom.value;
            const dateTo = logDateTo.value;

            // Construct query parameters
            let queryParams = `action=fetchLogs&page=${page}`;
            if (actionFilter) {
                queryParams += `&actionFilter=${encodeURIComponent(actionFilter)}`;
            }
            if (dateFrom) {
                queryParams += `&dateFrom=${encodeURIComponent(dateFrom)}`;
            }
            if (dateTo) {
                queryParams += `&dateTo=${encodeURIComponent(dateTo)}`;
            }

            try {
                const response = await fetch(`getZinnen.php?${queryParams}`);
                const data = await response.json();

                if (!data.success) {
                    console.error('Failed to fetch logs:', data.error);
                    alert('Failed to fetch logs. Please try again.');
                    return;
                }

                // Populate the logs table
                populateLogsTable(data.logs);

                // Handle pagination
                currentLogPage = data.pagination.currentPage;
                totalLogPages = data.pagination.totalPages;
                populateLogsPagination(currentLogPage, totalLogPages);
            } catch (error) {
                console.error('Error fetching logs:', error);
                alert('An error occurred while fetching logs.');
            }
        }

        // Function to populate logs into the table
        function populateLogsTable(logs) {
            logsTableBody.innerHTML = ''; // Clear existing logs

            if (logs.length === 0) {
                logsTableBody.innerHTML = '<tr><td colspan="5" class="text-center">No logs found.</td></tr>';
                return;
            }

            logs.forEach((log, index) => {
                const tr = document.createElement('tr');

                // ID: Assuming you want to show the auto-increment ID
                // If the `action_logs` table has an `id` field, include it in the SELECT statement
                // Otherwise, you might need to adjust accordingly
                // For now, we'll skip the ID as it's not selected in `fetchLogs`
                // Alternatively, modify the `fetchLogs` function to include `id`

                // To include ID, modify the SELECT statement in fetchLogs to:
                // SELECT id, action, parameters, ip_address, datetime FROM action_logs ...

                // Assuming 'id' is included
                const idCell = document.createElement('td');
                idCell.textContent = log.id || '-';
                tr.appendChild(idCell);

                // Action
                const actionCell = document.createElement('td');
                actionCell.textContent = sanitizeHTML(log.action);
                tr.appendChild(actionCell);

                // Parameters (display as formatted JSON)
                const paramsCell = document.createElement('td');
                paramsCell.innerHTML = `<pre>${sanitizeHTML(JSON.stringify(log.parameters, null, 2))}</pre>`;
                tr.appendChild(paramsCell);

                // IP Address
                const ipCell = document.createElement('td');
                ipCell.textContent = sanitizeHTML(log.ip_address);
                tr.appendChild(ipCell);

                // Date & Time
                const datetimeCell = document.createElement('td');
                datetimeCell.textContent = sanitizeHTML(log.datetime);
                tr.appendChild(datetimeCell);

                logsTableBody.appendChild(tr);
            });
        }

        // Function to populate pagination controls
        function populateLogsPagination(current, total) {
            logsPagination.innerHTML = ''; // Clear existing pagination

            // Previous Button
            const prevLi = document.createElement('li');
            prevLi.className = `page-item ${current === 1 ? 'disabled' : ''}`;
            const prevLink = document.createElement('a');
            prevLink.className = 'page-link';
            prevLink.href = '#';
            prevLink.textContent = 'Previous';
            prevLink.addEventListener('click', function(e) {
                e.preventDefault();
                if (current > 1) {
                    fetchAndDisplayLogs(current - 1);
                }
            });
            prevLi.appendChild(prevLink);
            logsPagination.appendChild(prevLi);

            // Page Numbers (limit to a reasonable number, e.g., 5)
            const maxPagesToShow = 5;
            let startPage = Math.max(1, current - Math.floor(maxPagesToShow / 2));
            let endPage = startPage + maxPagesToShow - 1;

            if (endPage > total) {
                endPage = total;
                startPage = Math.max(1, endPage - maxPagesToShow + 1);
            }

            for (let i = startPage; i <= endPage; i++) {
                const pageLi = document.createElement('li');
                pageLi.className = `page-item ${i === current ? 'active' : ''}`;
                const pageLink = document.createElement('a');
                pageLink.className = 'page-link';
                pageLink.href = '#';
                pageLink.textContent = i;
                pageLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    fetchAndDisplayLogs(i);
                });
                pageLi.appendChild(pageLink);
                logsPagination.appendChild(pageLi);
            }

            // Next Button
            const nextLi = document.createElement('li');
            nextLi.className = `page-item ${current === total ? 'disabled' : ''}`;
            const nextLink = document.createElement('a');
            nextLink.className = 'page-link';
            nextLink.href = '#';
            nextLink.textContent = 'Next';
            nextLink.addEventListener('click', function(e) {
                e.preventDefault();
                if (current < total) {
                    fetchAndDisplayLogs(current + 1);
                }
            });
            nextLi.appendChild(nextLink);
            logsPagination.appendChild(nextLi);
        }

        /**
         * Sanitize HTML to prevent XSS - moved to top of script
         */
    }



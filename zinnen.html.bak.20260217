/**
 * Event listener for the Confirm Delete EAF button in the modal.
 * This sends a request to the backend to delete the specified EAF file.
 */
document.getElementById('confirmDeleteEAFBtn').addEventListener('click', async function() {
    if (!videoToDeleteEAF) {
        console.error('No EAF file selected for deletion.');
        return;
    }

    const { rowId, videoIndex, filename, zinArray } = videoToDeleteEAF;


    // console.log(`Deleting EAF file: ${filename} (Row ID: ${rowId}, Video Index: ${videoIndex})`);

    try {
        // Send a POST request to the backend to delete the EAF file
        const response = await fetch(`getZinnen.php?action=deleteEAF&filename=${encodeURIComponent(filename)}`, {
            method: 'POST'
        });
        const data = await response.json();

        if (data.success) {
            // console.log(`EAF file "${filename}" deleted successfully.`);
            alert(`EAF file "${filename}" deleted successfully.`);

            // Update the specific video container's UI by removing the 'eaf-present' class
            const videoContainer = document.getElementById(`videoContainer-${rowId}-${videoIndex}`);
            if (videoContainer) {
                videoContainer.classList.remove('eaf-present');
            }

            // Disable the Delete EAF button since the EAF file has been deleted
            const deleteEAFBtn = document.querySelector(`button.deleteEAF-btn[data-id="${rowId}"][data-videoindex="${videoIndex}"]`);
            if (deleteEAFBtn) {
                deleteEAFBtn.disabled = true;
            }
        } else {
            console.error('Failed to delete EAF file:', data.error);
            alert('Failed to delete the EAF file. Please try again later.');
        }
    } catch (error) {
        console.error('Error deleting EAF file:', error);
        alert('An error occurred while deleting the EAF file. Please check your connection and try again.');
    } finally {
        // Reset the videoToDeleteEAF object
        videoToDeleteEAF = null;

        // Hide the Delete EAF Confirmation Modal
        const deleteEAFModalElement = document.getElementById('deleteEAFConfirmationModal');
        const deleteEAFModal = bootstrap.Modal.getInstance(deleteEAFModalElement);
        if (deleteEAFModal) {
            deleteEAFModal.hide();
        }
    }
});


function editZin(rowId, newZin) {
    fetch('getZinnen.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `action=editZin&rowId=${rowId}&zin=${encodeURIComponent(newZin)}`
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // console.log('Zin updated successfully for row:', rowId);
        } else {
            // console.error('Failed to update zin:', data.error);
            alert('Failed to update zin. Please try again.');
        }
    })
    .catch(error => {
        console.error('Error updating zin:', error);
        alert('An error occurred while updating zin.');
    });
}


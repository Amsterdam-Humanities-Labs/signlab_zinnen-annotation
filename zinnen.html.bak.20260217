// Open Upload EAF Modal
function openUploadEAFModal(filename, rowId, zin) {
    // Set the video filename in the hidden input
    document.getElementById('uploadVideoFilename').value = filename;

    // Set the row ID in the hidden input
    document.getElementById('uploadVideoRowId').value = rowId;

    document.getElementById('uploadVideoZin').value = zin;

    // Show the upload modal
    const uploadModal = new bootstrap.Modal(document.getElementById('uploadEAFModal'));
    uploadModal.show();
}

// Handle EAF Upload Form Submission
document.getElementById('uploadEAFForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const formData = new FormData(this);
    const filename = document.getElementById('uploadVideoFilename').value;
    const rowId = document.getElementById('uploadVideoRowId').value;
    const zin = document.getElementById('uploadVideoZin').value;
    // Replace whitespace with _ and remove any special chars
    var zinArray = zin.replace(/[^a-zA-Z0-9_]/g, '');
    // Get filename from formData
    var eafFile = formData.get('eafFile');
    eafFile = eafFile.name;
    // Remove anything from ( on
    var eafArray = eafFile.split('(')[0];
    eafArray = eafArray.split('.')[0];  
    // Remove any trailing whitespace in eafArray and zinArray
    eafArray = eafArray.trim();
    zinArray = zinArray.trim();

    console.log("ZIN"+zinArray, "EAF"+eafArray);
    //when zinArray is empty then skip this check
    if(zinArray) {
    // Compare eafFile value with zinArray
    if(eafArray !== zinArray) {
        // console.log(eafArray, zinArray);
        //show warning modal
        const warningModal = new bootstrap.Modal(document.getElementById('warningModal'));
        warningModal.show();
        return;
    }
}

    fetch('getZinnen.php?action=uploadEAF', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // console.log('EAF file uploaded successfully.');
            alert('EAF file uploaded successfully.');
            // Hide the upload modal
            const uploadModalElement = document.getElementById('uploadEAFModal');
            const uploadModal = bootstrap.Modal.getInstance(uploadModalElement);
            if (uploadModal) {
                uploadModal.hide();
            }
            // Update the specific video container's background color
            const videoContainers = document.querySelectorAll(`.video-container[data-filename="${filename}"]`);
            videoContainers.forEach(container => {
                container.classList.add('eaf-present');
            });
            // Enable the Delete EAF button
            const deleteEAFBtns = document.querySelectorAll(`button.deleteEAF-btn[data-id="${rowId}"]`);
            deleteEAFBtns.forEach(btn => {
                btn.disabled = false;
            });
        } else {
            console.error('Failed to upload EAF file:', data.error);
            alert('Failed to upload EAF file: ' + data.error);
        }
    })
    .catch(error => {
        console.error('Error uploading EAF file:', error);
        alert('An error occurred while uploading the EAF file.');
    });
});


/**
* Parse SRT data into an array of subtitle objects.
* @param {string} data - The raw SRT file content.
* @returns {Array} Array of subtitle objects with startTime, endTime, and text.
*/
function parseSRT(data) {
const srt = data.replace(/\r/g, '');
const regex = /(\d+)\n(\d{2}:\d{2}:\d{2},\d{3}) --> (\d{2}:\d{2}:\d{2},\d{3})\n([\s\S]*?)(?=\n\n|\n*$)/g;
const result = [];
let match;

while ((match = regex.exec(srt)) !== null) {
    result.push({
        index: parseInt(match[1], 10),
        startTime: toSeconds(match[2]),
        endTime: toSeconds(match[3]),
        text: match[4].replace('\n', '<br>')
    });
}

return result;
}

/**
* Convert time string to seconds.
* @param {string} time - Time in format "HH:MM:SS,mmm".
* @returns {number} Time in seconds.
*/
function toSeconds(time) {
const parts = time.split(':');
const secParts = parts[2].split(',');
return parseInt(parts[0], 10) * 3600 +
       parseInt(parts[1], 10) * 60 +
       parseFloat(secParts[0] + '.' + secParts[1]);
}

/**
* Load and parse an SRT file from a given URL.
* @param {string} url - The URL of the SRT file.
* @returns {Promise<Array>} Promise resolving to an array of subtitle objects.
*/
async function loadSRT(url) {
if (!url) return [];
try {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`Failed to load ${url}`);
    const text = await response.text();
    return parseSRT(text);
} catch (error) {
    console.error(error);
    return [];
}
}

/**
* Synchronize subtitles with video playback.
* @param {HTMLVideoElement} video - The video element.
* @param {Array} subtitles - Array of subtitle objects.
* @param {HTMLElement} subtitleDiv - The div to display subtitles.
*/
function synchronizeSubtitles(video, subtitles, subtitleDiv) {
// console.log(video,  subtitles, subtitleDiv);
video.addEventListener('timeupdate', () => {
    const currentTime = video.currentTime;
    const currentSubtitle = subtitles.find(sub => currentTime >= sub.startTime && currentTime <= sub.endTime);
    if (currentSubtitle) {
        subtitleDiv.innerHTML = currentSubtitle.text;
        subtitleDiv.style.display = 'block';
    } else {
        subtitleDiv.style.display = 'none';
    }
});

video.addEventListener('ended', () => {
    subtitleDiv.style.display = 'none';
});
}
    

                    </div>  
                </div>
            </div>
        </div>

    <!-- deleteZinModal -->
    <div class="modal fade" id="deleteZinModal" tabindex="-1" aria-labelledby="deleteZinModalLabel" aria-hidden="true"  data-zin="">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteZinModalLabel">Confirm Delete Sentence</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

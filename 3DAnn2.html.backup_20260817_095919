    function parseTimeStamp(timeStr) {
      const [h, m, s] = timeStr.split(':');
      const [sec, ms] = s.split(',');
      return parseInt(h)*3600 + parseInt(m)*60 + parseInt(sec) + parseInt(ms)/1000;
    }

    function parseTimeRange(rangeStr) {
      if (!rangeStr || typeof rangeStr !== 'string') return { start: 0, end: 0 };
      const parts = rangeStr.split('-->');
      if (parts.length !== 2) return { start: 0, end: 0 };
      return { start: parseTimeStamp(parts[0].trim()), end: parseTimeStamp(parts[1].trim()) };
    }

    function transformSubtitles(rawSubtitles) {
      const trackMapping = {
        'Nederlands': 0,
        'Gebaar-voor-Gebaar': 1,
        'Signbank ID glossen': 2
      };
      const transformed = [];
      Object.keys(rawSubtitles).forEach(trackKey => {
        const tier = trackMapping[trackKey] || 0;
        const data = rawSubtitles[trackKey];
        if (!data || data.length === 0) return;
        if (Array.isArray(data)) {
          uniqueId++;
          const { start, end } = parseTimeRange(data[1]);
          const text = data[2] || '';
          transformed.push({ id: uniqueId, text, start, end, tier, committed: true });
        } else if (typeof data === 'object') {
          const keys = Object.keys(data).filter(k => !isNaN(k)).sort((a, b) => parseInt(a) - parseInt(b));
          for (let i = 0; i < keys.length; i += 3) {
            uniqueId++;
            const timing = data[keys[i + 1]];
            const { start, end } = parseTimeRange(timing);
            const text = data[keys[i + 2]] || '';
            transformed.push({ id: uniqueId, text, start, end, tier, committed: true });
          }
        }
      });
      const tierCounters = {};
      transformed.forEach(sub => {
        tierCounters[sub.tier] = (tierCounters[sub.tier] || 0) + 1;
        sub.id = `tier${sub.tier}_${tierCounters[sub.tier]}`;
      });
      return transformed;
    }

    async function fetchSubtitlesFromServer() {
      const params = new URLSearchParams(window.location.search);
      let fileParam = params.get('filename') || '';
      // Fallback: extract filename from glb parameter if filename not provided
      if (!fileParam) {
        const glbParam = params.get('glb') || '';
        if (glbParam) {
          // Extract filename without path and extension (e.g., M20241210_0289_251118_0)
          fileParam = glbParam.split('/').pop().replace(/\.[^.]+$/, '');
        }
      }
      try {
        const response = await fetch(`getZinnen.php?action=fetchSubtitles&filename=${encodeURIComponent(fileParam)}`);
        const data = await response.json();
        if (data.success && data.subtitles) {
          subtitles = transformSubtitles(data.subtitles);
          renderAll();
          // Verify SRT file integrity on load
          verifySubtitlesOnDisk();
        } else {
          console.error('Failed to load subtitles', data.error);
        }
      } catch (err) {
        console.error('Error fetching subtitles', err);
      }
    }
    fetchSubtitlesFromServer();

    // Resolve the save filename (supports ?filename= and ?glb= fallback), sanitized.
    function getSaveFilename() {
      const params = new URLSearchParams(window.location.search);
      let fileParam = params.get('filename') || '';
      if (!fileParam) {
        const glbParam = params.get('glb') || '';
        if (glbParam) {
          fileParam = glbParam.split('/').pop().replace(/\.[^.]+$/, '');
        }
      }
      return fileParam.replace(/\s+/g, '_');
    }

    // Toast notification (success / error)
    function showToast(message, type = 'success', duration = 2500) {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = 'toast-msg ' + type;
      toast.textContent = message;
      container.appendChild(toast);
      requestAnimationFrame(() => toast.classList.add('show'));
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, duration);
    }

    // Verify the annotation files actually landed on disk after saving
    async function verifySubtitlesOnDisk() {
      const fileParam = getSaveFilename();
      if (!fileParam) return;
      try {
        const response = await fetch(`getZinnen.php?action=verifySubtitles&filename=${encodeURIComponent(fileParam)}`);
        const data = await response.json();
        if (data.success && data.verified === false && data.mismatches) {
          console.warn('SRT mismatch detected:', data.mismatches);
          showToast('Let op: opgeslagen bestand wijkt af van editor!', 'error', 5000);
        }
      } catch (err) {
        console.error('Verification error', err);
      }
    }

    // Track unsaved changes so we can guarantee a save before the user leaves
    let hasUnsavedChanges = false;
    let isSavingBeforeUnload = false;

    // Last-resort synchronous save when the tab/window is closing
    window.addEventListener('beforeunload', function () {
      if (hasUnsavedChanges && !isSavingBeforeUnload) {
        const fileParam = getSaveFilename();
        if (fileParam) {
          const blob = new Blob([JSON.stringify({ subtitles: subtitles })], { type: 'application/json' });
          navigator.sendBeacon('getZinnen.php?action=saveSubtitlesAndEAFFiles&filename=' + encodeURIComponent(fileParam), blob);
        }
      }
    });

    // Intercept in-page navigation links to save before leaving
    document.addEventListener('click', function (e) {
      const link = e.target.closest('a[href]');
      if (!link || !hasUnsavedChanges) return;
      const href = link.getAttribute('href');
      if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;
      e.preventDefault();
      isSavingBeforeUnload = true;
      saveAndNavigate(href);
    });

    async function saveAndNavigate(destination) {
      try {
        clearTimeout(autosaveTimer);
        await performUpload();
        showToast('Opgeslagen!', 'success', 1000);
        setTimeout(() => { window.location.href = destination; }, 300);
      } catch (err) {
        showToast('Opslaan mislukt!', 'error', 4000);
        isSavingBeforeUnload = false;
        if (confirm('Opslaan is mislukt. Toch de pagina verlaten?')) {
          hasUnsavedChanges = false;
          window.location.href = destination;
        }
      }
    }

    // Save on browser back/forward as well
    window.addEventListener('popstate', function () {
      if (hasUnsavedChanges) {
        saveAndNavigate(document.location.href);
      }
    });

    // Re-verify on disk when returning to the tab (no pending edits)
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible' && !hasUnsavedChanges) {
        verifySubtitlesOnDisk();
      }
    });

    function uploadSubtitles() {
      hasUnsavedChanges = true;
      clearTimeout(autosaveTimer);
      autosaveTimer = setTimeout(() => { performUpload().catch(() => {}); }, 1000);
    }

    async function performUpload() {
      const sanitizedFileParam = getSaveFilename();
      if (!sanitizedFileParam) {
        console.warn("Cannot save subtitles without a filename.");
        return;
      }
      try {
        console.log("Performing autosave:", subtitles);
        const response = await fetch('getZinnen.php?action=saveSubtitlesAndEAFFiles&filename='+sanitizedFileParam, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subtitles: subtitles })
        });
        const data = await response.json();
        if (data.success) {
          console.log("Autosave successful.");
          hasUnsavedChanges = false;
          document.getElementById('saveSubtitlesBtn').textContent = "Autosave Enabled";
          showToast('Saving successful', 'success');
          // Confirm the files really landed on disk
          verifySubtitlesOnDisk();
        } else {
          console.error("Autosave failed:", data.error);
          document.getElementById('saveSubtitlesBtn').textContent = "Save Failed!";
          showToast('Save failed: ' + data.error, 'error', 5000);
          throw new Error(data.error || 'Save failed');
        }
      } catch (err) {
        console.error('Upload error', err);
        document.getElementById('saveSubtitlesBtn').textContent = "Save Error!";
        showToast('Network error - changes NOT saved!', 'error', 5000);
        throw err;
      }
    }

    function addSubtitle() {
      uniqueId++;
      const newStart = 0, defaultDur = 0.2;
      subtitles.push({ id: uniqueId, text: '', start: newStart, end: newStart + defaultDur, tier: 0 });
      renderAll();
      uploadSubtitles();
    }

    // ============================================
    // GLOSSARY SEARCH FUNCTIONS
    // ============================================

    // Filter glosses based on senses
    function filterSensesList(searchTerm, container) {
        let lowerSearchTerm = searchTerm.toLowerCase().trim();
        if (!lowerSearchTerm) return [];
        const specialChars = /[^\w\s]/g;
        lowerSearchTerm = lowerSearchTerm.replace(specialChars, '');
        return glosses.filter(gloss => {
            const senses = gloss["Senses: Dutch"];
            if (senses && typeof senses === 'object') {
                for (const key in senses) {
                    const senseText = senses[key]?.toLowerCase();
                    if (senseText) {
                        const senseWords = senseText.split(',').map(word => word.trim());
                        if (senseWords.includes(lowerSearchTerm)) {
                            return true;
                        }
                    }
                }
            }
            return false;
        });
    }

    // Show suggestions based on zinArray
    function showSuggestions(container) {
        const suggestiesContainer = container.querySelector('#suggesties-results');
        if (!suggestiesContainer) return;

        suggestiesContainer.innerHTML = '<i>Loading suggestions...</i>';
        let allSuggestions = [];
        let processedWords = new Set();

        currentZinArray.forEach(word => {
            let lowerWord = word.toLowerCase().trim();
            const specialChars = /[^\w\s]/g;
            lowerWord = lowerWord.replace(specialChars, '');
            if (lowerWord && !processedWords.has(lowerWord)) {
                const matches = filterSensesList(lowerWord, container);
                allSuggestions = allSuggestions.concat(matches);
                processedWords.add(lowerWord);
            }
        });

        // Remove duplicate glosses
        const uniqueSuggestions = allSuggestions.filter((gloss, index, self) =>
            index === self.findIndex((g) => (g.id === gloss.id))
        );

        displayGlosses(uniqueSuggestions, container, suggestiesContainer);
    }

    // Filter glosses by dropdown selections
    function filterGlosses(filterId, filterValue, container) {
        let strong = container.querySelector('select[data-filter="sterke hand"]')?.value || "";
        let handed = container.querySelector('select[data-filter="handedness"]')?.value || "";
        let weak   = container.querySelector('select[data-filter="zwakke hand"]')?.value || "";
        let movement = container.querySelector('select[data-filter="Beweging"]')?.value || "";
        let location = container.querySelector('select[data-filter="Locatie"]')?.value || "";
        strong = strong.replace("Sterke Hand", "");
        handed = handed.replace("Handedness", "");
        weak = weak.replace("Zwakke Hand", "");
        movement = movement.replace("Beweging", "");
        location = location.replace("Locatie", "");

        const filtered = glosses.filter(g => {
            if (strong && g["Strong Hand"] !== strong) return false;
            if (handed && g["Handedness"] !== handed) return false;
            if (weak && g["Weak Hand"] !== weak) return false;
            if (movement && g["Movement Direction"] !== movement) return false;
            if (location && g["Location"] !== location) return false;
            return true;
        });

        const filteredResults = container.querySelector('#filtered-results');
        if (filteredResults) {
            displayGlosses(filtered, container, filteredResults);
        }
    }

    // Display glosses in target element
    function displayGlosses(matches, container, targetElement) {
        if (!targetElement) {
            console.error("Target element for displayGlosses not found in container:", container);
            return;
        }
        targetElement.innerHTML = "";

        if (matches.length) {
            matches.slice(0, 50).forEach(entry => {
                const itemDiv = document.createElement('div');
                itemDiv.className = 'glossary-item';
                itemDiv.textContent = entry['Annotation ID Gloss: Dutch'];
                const senses = entry["Senses: Dutch"];
                if (senses && typeof senses === 'object' && Object.keys(senses).length > 0) {
                    const senseText = Object.values(senses).join('; ');
                    itemDiv.title = `Senses: ${senseText}`;
                    const senseSpan = document.createElement('span');
                    senseSpan.style.fontSize = '0.8em';
                    senseSpan.style.color = 'gray';
                    senseSpan.style.marginLeft = '5px';
                    senseSpan.textContent = `(${senseText.substring(0, 20)}${senseText.length > 20 ? '...' : ''})`;
                    itemDiv.appendChild(senseSpan);
                }

                itemDiv.addEventListener('mouseenter', () => showVideoPreview(itemDiv, entry.Video));
                itemDiv.addEventListener('mouseleave', hideVideoPreview);
                itemDiv.addEventListener('mousedown', function(e) {
                    e.preventDefault();
                    const content = container.querySelector('.content');
                    content.textContent = entry['Annotation ID Gloss: Dutch'];
                    content.dispatchEvent(new Event('blur', { bubbles: true }));
                    hideVideoPreview();
                    const extraRow = container.querySelector('.row');
                    if (extraRow) extraRow.style.display = 'none';
                });
                targetElement.appendChild(itemDiv);
            });
            targetElement.style.display = 'block';
        } else {
            targetElement.innerHTML = '<i>No matches found.</i>';
            targetElement.style.display = 'block';
        }
    }

    document.getElementById('saveSubtitlesBtn').addEventListener('click', uploadSubtitles);
    document.getElementById('downloadSubtitleBtn').addEventListener('click', downloadSubtitle);
    document.getElementById('addSubtitleBtn').addEventListener('click', addSubtitle);
    renderAll();

    // ============================================
    // PLAYBACK CONTROLS
    // ============================================
    let playing = false, playInterval = null;
    const playBtn = document.getElementById('playBtn');

    playBtn.addEventListener('click', () => {
      if (buttonLoopInterval) {
        clearInterval(buttonLoopInterval);
        buttonLoopInterval = null;
        const currentlyLoopingSubId = buttonLoopActiveSub ? buttonLoopActiveSub.id : null;
        buttonLoopActiveSub = null;
        const allLoopBtns = document.querySelectorAll('.loop-btn');
        allLoopBtns.forEach(btn => {
          const parentBox = btn.closest('.subtitle-box');
          if (parentBox && parentBox.dataset.id === currentlyLoopingSubId) {
            btn.textContent = 'Loop';
          }
        });
      }
      playing = !playing;
      if (playing) {
        playBtn.innerText = '(P) Pause';
        loopSubtitle = null;
        loopDirection = 1;
        playInterval = setInterval(() => {
          let newTime;
          if (loopSubtitle && autoLoopEnabled) {
            newTime = currentTime + (loopDirection * (playbackSpeed / animationFrameRate));
            if (loopDirection === 1 && newTime >= loopSubtitle.end) {
              newTime = loopSubtitle.end;
              loopDirection = -1;
            } else if (loopDirection === -1 && newTime <= loopSubtitle.start) {
              newTime = loopSubtitle.start;
              loopDirection = 1;
            }
            setCanvasTime(newTime, "playing-hover-loop");
          } else {
            newTime = currentTime + (playbackSpeed / animationFrameRate);
            if (newTime >= animationDuration) {
              newTime = 0;
            }
            setCanvasTime(newTime, "playing");
          }
        }, 1000 / animationFrameRate);
      } else {
        playBtn.innerText = '(P) Play';
        clearInterval(playInterval);
        playInterval = null;
        loopSubtitle = null;
        loopDirection = 1;
      }
    });

    // Hotkey listener
    document.addEventListener('keydown', (e) => {
      if (e.target.isContentEditable || e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') {
        return;
      }
      if (e.key.toLowerCase() === 'p') {
        e.preventDefault();
        playBtn.click();
      }
      const speedKeys = { '1': '0.25', '2': '0.5', '3': '0.75', '4': '1' };
      if (speedKeys[e.key]) {
        e.preventDefault();
        const speed = speedKeys[e.key];
        const speedButton = document.querySelector(`.speed-btn[data-speed="${speed}"]`);
        if (speedButton) {
          speedButton.click();
        }
      }
      if (e.key === '+' || e.key === '=') {
        e.preventDefault();
        document.getElementById('zoomInBtn').click();
      } else if (e.key === '-' || e.key === '_') {
        e.preventDefault();
        document.getElementById('zoomOutBtn').click();
      }

      // Arrow keys nudge the selected gloss boundary (freezes against locked neighbours)
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        const sub = getSelectedSub();
        if (!sub) return;
        const dir = (e.key === 'ArrowRight') ? 1 : -1;
        e.preventDefault();
        if (e.ctrlKey || e.metaKey) nudgeWholeBlock(sub, dir);   // whole block
        else if (e.shiftKey)        nudgeRightBoundary(sub, dir); // right edge
        else                        nudgeLeftBoundary(sub, dir);  // left edge
        return;
      }

      // Tab / Shift+Tab: walk glosses in the same tier (time order), clamp at ends
      if (e.key === 'Tab') {
        e.preventDefault();
        const cur = getSelectedSub();
        if (!cur) {
          if (!subtitles.length) return;
          const nearest = subtitles.slice().sort((a, b) =>
            Math.abs(a.start - currentTime) - Math.abs(b.start - currentTime))[0];
          selectSub(nearest.id, { snapPlayhead: true });
          return;
        }
        const tierBlocks = subtitles.filter(s => s.tier === cur.tier).sort((a, b) => a.start - b.start);
        const idx = tierBlocks.findIndex(s => s.id === cur.id);
        const nextIdx = e.shiftKey ? idx - 1 : idx + 1;
        if (nextIdx < 0 || nextIdx >= tierBlocks.length) return; // clamp at ends
        selectSub(tierBlocks[nextIdx].id, { snapPlayhead: true });
        return;
      }

      // Enter edits the selected gloss's text
      if (e.key === 'Enter') {
        const sub = getSelectedSub();
        if (!sub) return;
        e.preventDefault();
        const box = document.querySelector('.subtitle-box[data-id="' + sub.id + '"]');
        enterEditMode(box);
        return;
      }
    });

    // Load glosses
    fetch('../glosses_transformed.json')
      .then(res => res.json())
      .then(data => {
        glosses = data.map(item => {
          const key = Object.keys(item)[0];
          return { id: key, ...item[key] };
        });
      });

    // Close dropdowns when clicking outside
    document.addEventListener('mousedown', function(e) {
      if (!e.target.closest('.subtitle-box')) {
        document.querySelectorAll('.dropdown').forEach(dd => dd.style.display = 'none');
      }
    });

    // Loop button handler
    function handleLoopButtonClick(sub, buttonElement) {
      if (buttonLoopInterval) {
        clearInterval(buttonLoopInterval);
        buttonLoopInterval = null;
        const currentlyLoopingSubId = buttonLoopActiveSub ? buttonLoopActiveSub.id : null;
        buttonLoopActiveSub = null;
        const allLoopBtns = document.querySelectorAll('.loop-btn');
        allLoopBtns.forEach(btn => {
          const parentBox = btn.closest('.subtitle-box');
          if (parentBox && parentBox.dataset.id === currentlyLoopingSubId) {
            btn.textContent = 'Loop';
          }
        });
        if (currentlyLoopingSubId === sub.id) {
          if (wasPlayingBeforeButtonLoop) {
            wasPlayingBeforeButtonLoop = false;
            if (!playing) playBtn.click();
          }
          return;
        }
      }
      if (playing) {
        wasPlayingBeforeButtonLoop = true;
        playing = false;
        clearInterval(playInterval);
        playBtn.innerText = '(P) Play';
      } else {
        wasPlayingBeforeButtonLoop = false;
      }
      buttonLoopActiveSub = sub;
      buttonElement.textContent = 'Stop Loop';
      setCanvasTime(sub.start, "button-loop-start");
      buttonLoopInterval = setInterval(() => {
        if (!buttonLoopActiveSub) {
          clearInterval(buttonLoopInterval);
          buttonLoopInterval = null;
          return;
        }
        let newTime = currentTime + (playbackSpeed / animationFrameRate);
        if (newTime >= buttonLoopActiveSub.end) {
          newTime = buttonLoopActiveSub.start;
        }
        setCanvasTime(newTime, "button-loop");
      }, 1000 / animationFrameRate);
    }

    // Scroll synchronization
    const customScrollbar = document.getElementById('customScrollbar');

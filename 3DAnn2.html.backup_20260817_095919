    // Capture 3D scene to 2D canvas at specific time
    function captureSceneToCanvas(canvasCtx, time) {
        if (!currentAnimationGroup || !isAnimationLoaded) return;
        const savedTime = currentTime;
        const targetFrame = animationFromFrame + (time * animationFrameRate);
        currentAnimationGroup.goToFrame(targetFrame);
        scene.render();
        const renderCanvas = document.getElementById("renderCanvas");
        // Center-crop the largest square from the 16:9 render so the square side
        // previews show the (centered) signer without horizontal distortion.
        const side = Math.min(renderCanvas.width, renderCanvas.height);
        const sx = (renderCanvas.width - side) / 2;
        const sy = (renderCanvas.height - side) / 2;
        const dim = Math.round(side / 2);
        canvasCtx.canvas.width = dim;
        canvasCtx.canvas.height = dim;
        canvasCtx.drawImage(renderCanvas, sx, sy, side, side, 0, 0, dim, dim);
        // Restore original time
        const restoreFrame = animationFromFrame + (savedTime * animationFrameRate);
        currentAnimationGroup.goToFrame(restoreFrame);
    }

    function setSideCaps(show) {
        const cl = document.getElementById('capLeft'), cr = document.getElementById('capRight');
        if (cl) cl.style.display = show ? 'block' : 'none';
        if (cr) cr.style.display = show ? 'block' : 'none';

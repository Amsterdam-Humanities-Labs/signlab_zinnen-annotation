  <script>
    // ============================================
    // 3D ANNOTATION EDITOR - BABYLON.JS VERSION
    // Fixed version with proper animation retargeting
    // ============================================

    // Global state
    const TIER_HEIGHT = 100;  // Increased from 80 for better usability
    let animationDuration = 5, subtitles = [], uniqueId = 0;
    let selectedSubId = null;   // id of the currently selected gloss (cyan outline)

    // ============================================
    // SMART DROPDOWN POSITIONING
    // ============================================
    function positionDropdown(dropdown, anchorElement) {
      if (!dropdown || !anchorElement) return;

      const rect = anchorElement.getBoundingClientRect();
      const dropdownRect = dropdown.getBoundingClientRect();
      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;

      // Check if dropdown would overflow right edge
      const wouldOverflowRight = rect.right + dropdownRect.width + 20 > viewportWidth;

      // Check if dropdown would overflow bottom edge
      const wouldOverflowBottom = rect.top + dropdownRect.height > viewportHeight;

      // Apply flip classes
      if (wouldOverflowRight) {
        dropdown.classList.add('flip-left');
      } else {
        dropdown.classList.remove('flip-left');
      }

      if (wouldOverflowBottom) {
        dropdown.classList.add('flip-up');
      } else {
        dropdown.classList.remove('flip-up');
      }
    }

    // Apply positioning to all visible dropdowns
    function updateDropdownPositions() {
      document.querySelectorAll('.glossary-dropdown, .subtitle-box .row').forEach(dropdown => {
        if (dropdown.style.display !== 'none') {
          const anchor = dropdown.closest('.subtitle-box');
          if (anchor) {
            positionDropdown(dropdown, anchor);
          }
        }
      });
    }

    // Update positions on scroll and resize
    window.addEventListener('scroll', updateDropdownPositions, { passive: true });
    window.addEventListener('resize', updateDropdownPositions, { passive: true });
    let autoLoopEnabled = true, loopSubtitle = null;
    let pendingStartTime = null, waitingForEnd = false;
    let lastMouseEvent = null;
    let pendingPreviewDiv = document.createElement('div');
    pendingPreviewDiv.id = "pendingPreviewDiv";
    let busyMoving = 0;
    let autosaveTimer = null;
    let loopDirection = 1;
    let buttonLoopActiveSub = null;
    let buttonLoopInterval = null;
    let wasPlayingBeforeButtonLoop = false;
    let playbackSpeed = 1;

    // Babylon.js variables (replacing video/canvas vars)
    let engine = null;
    let scene = null;
    let currentAnimationGroup = null;
    let animationFrameRate = 30;  // Default, may be updated from GLB
    let animationFromFrame = 0;   // Start frame of animation
    let animationToFrame = 0;     // End frame of animation
    let isAnimationLoaded = false;
    let currentTime = 0;

    // Side canvas elements for start/end frame preview
    const canvasLeft = document.getElementById('canvasLeft');
    const canvasRight = document.getElementById('canvasRight');
    const ctxLeft = canvasLeft.getContext('2d');
    const ctxRight = canvasRight.getContext('2d');

    // Character controller state (from blendAnims pattern)
    let character = null;           // Base mesh result
    let morphTargetManagers = [];   // Morph target managers from base mesh
    let skeleton = null;            // Skeleton from base mesh
    let baseCharacterLoaded = false;
    let camera = null;              // ArcRotateCamera (module scope for hand focus)
    let avatarRoot = null;          // TransformNode wrapping the base character
    let lightingRig = null;         // Result of setupLighting()
    let backdropMaterial = null;    // Backdrop PBR material (for the colour UI)
    let trackedHand = null;         // "left" | "right" | null - hand the camera follows

    // Base character URL - CC (Character Creator) avatar, same one the babyloncc/dist viewer uses.
    const BASE_CHARACTER_URL = "/zin/PalmerPolo1024uastc.glb";
    // CC helper meshes that should never render, and the metre→centimetre position scale
    // for animations. Mirrors the proven CC retargeting pipeline in babyloncc/dist/index.html.
    const EXCLUDED = ["cc_base_eyeocclusion","cc_base_tear_ducts","cc_base_tearline",
      "chin_curtain_sparse","male_bushy","mustache_horseshoe","stubble_neck",
      "cc_base_eye_primitive1","cc_base_eye_primitive3"];
    const POS_SCALE = 100;

    // ============================================
    // BABYLONCC STUDIO-RENDER CONFIG
    // Ported from github.com/J-Andersen-UvA/BabylonCC (src/config/*).
    // Asset URLs are absolute so they resolve next to the base character.
    // ============================================
    const RENDER_CONFIG = {
      hardwareScalingLevel: 1,
      clearColor: "#1F242BFF",
      imageProcessing: {
        toneMappingEnabled: true,
        exposure: 1.0,
        contrast: 1.0,
      },
      lighting: {
        // NOTE: served as .envbin (not .env) because Apache denies *.env files (they
        // usually hold secrets). Babylon is told the real format via forcedExtension below.
        environmentUrl: "/animMIDI/babyloncc/dist/environment.envbin",
        iblIntensity: 0.35,
        sunIntensity: 1.0,
        sunDirection: { x: -0.4, y: -1.0, z: -0.3 },
        hemiFillEnabled: true,
        hemiIntensity: 0.25,
        hemiGroundColor: "#262626",
        hemiDiffuseColor: "#FFFFFF",
        hemiSpecularColor: "#333333",
        studioThreePoint: {
          enabled: true,
          target: { x: 0, y: 1.25, z: 0 },
          key:  { position: { x: -2.4, y: 3.2, z: 2.8 }, intensity: 70, color: "#ffe5ba", angle: 0.85, exponent: 1.8 },
          fill: { position: { x:  2.6, y: 2.1, z: 2.0 }, intensity: 50, color: "#DDEBFF", angle: 1.1,  exponent: 1.3 },
          rim:  { position: { x:  1.5, y: 2.7, z: -2.8 }, intensity: 30, color: "#E8F5FF", angle: 0.75, exponent: 2.2 },
        },
      },
      shadows: {
        mapSize: 2048,
        usePercentageCloserFiltering: true,
        studio: { enabled: true, mapSize: 1024, key: true, fill: false, rim: true },
      },
    };

    // Camera framing focuses on a chosen bone (CC spine), falling back to a fixed target.
    const AVATAR_CAMERA_CONFIG = {
      focusBoneNames: ["spine_05"],
      fallbackTarget: { x: 0, y: 1.35, z: 0 },
      targetOffset: { x: 0, y: 0.05, z: 0 },
      alpha: Math.PI / 2,
      beta: 1.6,
      radius: 0.9725,  // user-tuned zoom distance (16:9 canvas framing)
      // Optional manual yaw offset (degrees) applied AFTER the automatic eye-facing
      // orientation. Leave at 0; only set this if the auto-orientation is consistently off.
      facingYDegrees: 0,
    };

    // Avatar material tuning (matte default is commented; specular studio preset active).
    const AVATAR_MATERIAL_CONFIG = {
      specularIntensity: 0.15,
      environmentIntensity: 0.25,
      roughness: 0.48,
      metallic: 0,
    };
    const AVATAR_MATERIAL_RULES = {
      alphaBlendRules: [
        { nameIncludes: ["hair"], backFaceCulling: true, renderingGroupId: 0 },
        { nameIncludes: ["eyelash"] },
      ],
      opaqueFallback: true,
      roughnessOverrides: [
        { nameIncludes: ["ss_slash_neck_top"], minimumRoughness: 0.64 },
        { nameIncludes: ["beard", "brow", "female_angled"], minimumRoughness: 0.6 },
      ],
      scalp: { nameIncludes: ["scalp"], renderingGroupId: 0, alphaIndex: 0 },
    };

    // Hand-focus button targets (CC hand bones).
    const HAND_TRACKING = {
      leftBoneNames: ["hand_l"],
      rightBoneNames: ["hand_r"],
      focusRadius: 1.35,
      targetOffset: { x: 0, y: 0, z: 0 },
    };

    // Small helpers shared by the ported modules
    const vec3FromConfig = (v) => new BABYLON.Vector3(v.x, v.y, v.z);

    let glosses = [];
    let currentZinArray = [];
    let currentSentenceRowId = null; // sentences.ID for the loaded clip (for MCP status saves)
    const zinDisplayElement = document.getElementById('zinDisplay');

    // Dropdown filter options for Zoeken
    let sterkeHandOptions = ["Sterke Hand", "A", "B", "C", "1", "5", "O"];
    let zwakkeHandOptions = ["Zwakke Hand", "A", "B", "C", "1", "5", "O", "None"];
    let handednessOptions = ["Handedness", "1h", "2h", "2ha", "2hs"];
    let locatieOptions = ["Locatie", "Neutral space", "Head", "Trunk", "Arm", "Hand"];
    let bewegingOptions = ["Beweging", "Up", "Down", "Left", "Right", "Forward", "Backward"];

    // Add event listener for the "Go back to Zinnen" button
    document.getElementById('backToZinnenBtn').addEventListener('click', function() {
      const urlParams = new URLSearchParams(window.location.search);
      const filename = urlParams.get('filename');
      let returnUrl = 'zinnen.html';
      if (filename) {
        returnUrl += `?edited=${filename}`;
      }
      window.location.href = returnUrl;
    });

    // ============================================
    // BABYLON.JS SCENE INITIALIZATION
    // ============================================

    // Disable auto-play on GLB load - MUST be set before any loading
    BABYLON.SceneLoader.OnPluginActivatedObservable.add(function(loader) {
      if (loader.name === "gltf") {
        loader.animationStartMode = BABYLON.GLTFLoaderAnimationStartMode.NONE;
      }
    });

    // ============================================
    // STUDIO LIGHTING RIG (ported from BabylonCC src/babylon/lighting.ts)
    // Environment IBL + ACES tone mapping + sun shadows + optional hemi fill
    // + three-point studio spotlights. Returns helpers to register shadow casters.
    // ============================================
    function setupLighting(scene, opts) {
      const cfg = RENDER_CONFIG;
      const L = cfg.lighting;

      scene.environmentIntensity = L.iblIntensity;
      scene.imageProcessingConfiguration.toneMappingEnabled = cfg.imageProcessing.toneMappingEnabled;
      scene.imageProcessingConfiguration.toneMappingType = BABYLON.ImageProcessingConfiguration.TONEMAPPING_ACES;
      scene.imageProcessingConfiguration.exposure = cfg.imageProcessing.exposure;
      scene.imageProcessingConfiguration.contrast = cfg.imageProcessing.contrast;

      // Image-based lighting from a prefiltered .env (ground projection off, so no skybox)
      let environmentTexture;
      if (L.environmentUrl) {
        // forcedExtension ".env" so Babylon parses it as an environment texture even though
        // the file is served with a .envbin extension (Apache blocks literal *.env).
        environmentTexture = BABYLON.CubeTexture.CreateFromPrefilteredData(L.environmentUrl, scene, ".env");
        environmentTexture.onLoadObservable.addOnce(() => {
          scene.environmentTexture = environmentTexture;
          console.log("[Lighting] environment ready");
        });
      }

      // Key directional "sun" with the main shadow generator
      const sun = new BABYLON.DirectionalLight("sun", vec3FromConfig(L.sunDirection).normalize(), scene);
      sun.intensity = L.sunIntensity;
      sun.position = new BABYLON.Vector3(50, 80, 50);
      sun.shadowMinZ = 0.1;
      sun.shadowMaxZ = 250;

      const makeShadowGen = (light, mapSize) => {
        const gen = new BABYLON.ShadowGenerator(mapSize, light);
        gen.usePercentageCloserFiltering = cfg.shadows.usePercentageCloserFiltering;
        gen.filteringQuality = BABYLON.ShadowGenerator.QUALITY_HIGH;
        return gen;
      };

      const shadowGenerator = makeShadowGen(sun, cfg.shadows.mapSize);

      // Hemispheric fill
      let hemi;
      if (L.hemiFillEnabled) {
        hemi = new BABYLON.HemisphericLight("hemiFill", new BABYLON.Vector3(0, 1, 0), scene);
        hemi.intensity = L.hemiIntensity;
        hemi.groundColor = BABYLON.Color3.FromHexString(L.hemiGroundColor);
        hemi.diffuse = BABYLON.Color3.FromHexString(L.hemiDiffuseColor);
        hemi.specular = BABYLON.Color3.FromHexString(L.hemiSpecularColor);
      }

      // Three-point studio spotlights
      const studioLights = [];
      const studioShadowGenerators = [];
      const tp = L.studioThreePoint;

      const createStudioLight = (name, lo, target, castsShadow) => {
        const pos = vec3FromConfig(lo.position);
        const dir = target.subtract(pos).normalize();
        const spot = new BABYLON.SpotLight(name, pos, dir, lo.angle, lo.exponent, scene);
        spot.intensity = lo.intensity;
        spot.diffuse = BABYLON.Color3.FromHexString(lo.color);
        spot.specular = BABYLON.Color3.FromHexString(lo.color);
        studioLights.push(spot);
        if (cfg.shadows.studio.enabled && castsShadow) {
          studioShadowGenerators.push(makeShadowGen(spot, cfg.shadows.studio.mapSize));
        }
      };

      if (tp && tp.enabled !== false) {
        const target = vec3FromConfig(tp.target);
        createStudioLight("studioKey", tp.key, target, cfg.shadows.studio.key);
        createStudioLight("studioFill", tp.fill, target, cfg.shadows.studio.fill);
        createStudioLight("studioRim", tp.rim, target, cfg.shadows.studio.rim);
      }

      const addShadowCaster = (mesh) => {
        shadowGenerator.addShadowCaster(mesh);
        studioShadowGenerators.forEach(g => g.addShadowCaster(mesh));
      };
      const setShadowReceiver = (mesh, receive) => { mesh.receiveShadows = receive; };

      return { sun, hemi, shadowGenerator, studioShadowGenerators, environmentTexture, addShadowCaster, setShadowReceiver };
    }

    // ============================================
    // BACKDROP (ported from BabylonCC src/babylon/loadBackdrop.ts)
    // Loads Backdrop.glb behind the avatar, applies a matte grey PBR material that
    // receives shadows. Stores the material so the colour UI can recolour it live.
    // ============================================
    async function loadBackdrop(scene) {
      const result = await BABYLON.SceneLoader.ImportMeshAsync("", "/animMIDI/babyloncc/dist/", "Backdrop.glb", scene);
      const backdropRoot = new BABYLON.TransformNode("Backdrop", scene);
      const mat = new BABYLON.PBRMaterial("Backdrop_Matte_Grey", scene);
      mat.albedoColor = BABYLON.Color3.FromHexString("#36383b");
      mat.roughness = 0.92;
      mat.metallic = 0;
      mat.specularIntensity = 0.18;
      mat.environmentIntensity = 0.18;
      mat.backFaceCulling = false;

      const importedNodes = [...result.transformNodes, ...result.meshes];
      const importedSet = new Set(importedNodes);
      importedNodes
        .filter(n => !n.parent || !importedSet.has(n.parent))
        .forEach(n => { n.parent = backdropRoot; });

      result.meshes.forEach(mesh => {
        mesh.alwaysSelectAsActiveMesh = true;
        mesh.receiveShadows = true;
        mesh.material = mat;
      });

      backdropMaterial = mat;
      console.log("[Backdrop] imported meshes:", result.meshes.length);
      return { root: backdropRoot, material: mat };
    }

    // ============================================
    // CAMERA / HAND FOCUS (ported from BabylonCC src/babylon/createScene.ts)
    // ============================================
    function boneTransformNode(bone) {
      if (bone.getTransformNode) {
        const n = bone.getTransformNode();
        if (n) return n;
      }
      return bone._linkedTransformNode || null;
    }

    function findFocusTargetByNames(scene, avatarRoot, names) {
      const focusNames = names.map(n => n.toLowerCase());
      for (const sk of scene.skeletons) {
        for (const bone of sk.bones) {
          if (!focusNames.includes(bone.name.toLowerCase())) continue;
          const node = boneTransformNode(bone);
          if (node) return { position: node.getAbsolutePosition(), source: `bone:${bone.name}` };
        }
      }
      const descendants = avatarRoot ? avatarRoot.getDescendants(false) : [];
      const focusNode = descendants.find(n => focusNames.includes(n.name.toLowerCase()));
      if (focusNode && focusNode.getAbsolutePosition) {
        return { position: focusNode.getAbsolutePosition(), source: `node:${focusNode.name}` };
      }
      return null;
    }

    function focusCameraOnAvatar(scene, avatarRoot) {
      const cam = scene.activeCamera;
      if (!cam) return;
      const ft = findFocusTargetByNames(scene, avatarRoot, AVATAR_CAMERA_CONFIG.focusBoneNames);
      const target = ft ? ft.position : vec3FromConfig(AVATAR_CAMERA_CONFIG.fallbackTarget);
      const finalTarget = target.add(vec3FromConfig(AVATAR_CAMERA_CONFIG.targetOffset));
      cam.setTarget(finalTarget);
      cam.alpha = AVATAR_CAMERA_CONFIG.alpha;
      cam.beta = AVATAR_CAMERA_CONFIG.beta;
      cam.radius = AVATAR_CAMERA_CONFIG.radius;
      console.log("[Camera] focused:", ft ? ft.source : "fallback", finalTarget.toString());
    }

    function focusCameraOnAvatarBone(scene, avatarRoot, boneNames, options) {
      options = options || {};
      const cam = scene.activeCamera;
      if (!cam) return false;
      const ft = findFocusTargetByNames(scene, avatarRoot, boneNames);
      if (!ft) {
        if (!options.silent) console.warn("[Camera] hand focus target not found:", boneNames);
        return false;
      }
      const targetOffset = options.targetOffset ? vec3FromConfig(options.targetOffset) : BABYLON.Vector3.Zero();
      const finalTarget = ft.position.add(targetOffset);
      cam.setTarget(finalTarget);
      cam.alpha = options.preserveOrbit ? cam.alpha : AVATAR_CAMERA_CONFIG.alpha;
      cam.beta = options.preserveOrbit ? cam.beta : AVATAR_CAMERA_CONFIG.beta;
      if (options.radius != null) cam.radius = options.radius;
      if (!options.silent) console.log("[Camera] hand focused:", ft.source, finalTarget.toString());
      return true;
    }

    // ============================================
    // EYE-FACING ORIENTATION
    // Computes the direction the avatar's eyes actually look (from mesh + head-bone
    // geometry) and rotates the avatar root so that direction points at the camera.
    // Continuous (not 90°-snapped) and self-correcting, so it works regardless of how
    // the GLB happens to import.
    // ============================================
    function groundDir(v) {
      const g = new BABYLON.Vector3(v.x, 0, v.z);
      const len = g.length();
      return len < 1e-5 ? null : g.scaleInPlace(1 / len);
    }

    function getHeadBonePosition(scene) {
      const names = new Set(["head", "cc_base_head", "cc_base_headnode", "facialbone_head"]);
      for (const sk of scene.skeletons) {
        for (const b of sk.bones) {
          if (!names.has(b.name.toLowerCase())) continue;
          const node = boneTransformNode(b);
          if (node) return node.getAbsolutePosition();
        }
      }
      return null;
    }

    // Returns { center, positions } of the (world-space) eye mesh centres, or null.
    function getEyeGeometry(avatarRoot) {
      const eyeMeshes = avatarRoot.getChildMeshes(false).filter(m => {
        const n = m.name.toLowerCase();
        return m.isEnabled() && n.includes("eye")
          && !n.includes("eyelash") && !n.includes("occlusion") && !n.includes("tear");
      });
      if (!eyeMeshes.length) return null;

      const positions = [];
      const center = BABYLON.Vector3.Zero();
      for (const m of eyeMeshes) {
        m.computeWorldMatrix(true);
        const c = m.getBoundingInfo().boundingBox.centerWorld;
        positions.push(c);
        center.addInPlace(c);
      }
      center.scaleInPlace(1 / eyeMeshes.length);
      return { center, positions };
    }

    // Best-effort horizontal "forward" the eyes look along, in world space.
    function computeEyeForward(scene, avatarRoot) {
      const eyes = getEyeGeometry(avatarRoot);
      if (!eyes) return null;
      const headPos = getHeadBonePosition(scene);

      // Primary: eyes sit in FRONT of the head joint, so eyeCenter - headPos is forward.
      if (headPos) {
        const f = groundDir(eyes.center.subtract(headPos));
        if (f) return f;
      }

      // Fallback: forward is perpendicular to the inter-eye (ear-to-ear) axis.
      if (eyes.positions.length >= 2) {
        const interEye = groundDir(eyes.positions[1].subtract(eyes.positions[0]));
        if (interEye) {
          let f = groundDir(new BABYLON.Vector3(interEye.z, 0, -interEye.x)); // rotate 90° in ground plane
          if (f && headPos) {
            const ref = groundDir(eyes.center.subtract(headPos));
            if (ref && BABYLON.Vector3.Dot(f, ref) < 0) f.scaleInPlace(-1);
          }
          if (f) return f;
        }
      }
      return null;
    }

    // Rotate the avatar so its eye-forward points at the camera. Returns true on success.
    function orientAvatarEyesToCamera(scene, avatarRoot) {
      const cam = scene.activeCamera;
      if (!cam || !avatarRoot) return false;

      avatarRoot.computeWorldMatrix(true);
      const forward = computeEyeForward(scene, avatarRoot);
      if (!forward) {
        console.warn("[Avatar] could not compute eye-facing direction");
        return false;
      }

      const eyes = getEyeGeometry(avatarRoot);
      const pivot = eyes ? eyes.center : avatarRoot.getAbsolutePosition();
      const toCamera = groundDir(cam.position.subtract(pivot));
      if (!toCamera) return false;

      // Signed yaw (Babylon left-handed convention) to rotate `forward` onto `toCamera`.
      const crossY = forward.x * toCamera.z - forward.z * toCamera.x;
      const yaw = Math.atan2(crossY, BABYLON.Vector3.Dot(forward, toCamera));

      avatarRoot.rotate(BABYLON.Axis.Y, yaw, BABYLON.Space.WORLD);
      avatarRoot.computeWorldMatrix(true);
      console.log("[Avatar] eyes->camera yaw:", BABYLON.Tools.ToDegrees(yaw).toFixed(1) + "°");
      return true;
    }

    // ============================================
    // ORIENTATION SNAP (ported from BabylonCC src/babylon/orientAvatarToCamera.ts)
    // Rotates the avatar root by the nearest 90° so it faces the camera. Self-no-ops
    // when already facing, so it is safe for this fixed-camera tool.
    // ============================================
    function snapAvatarToCameraInRightAngles(scene, avatarRoot) {
      const RIGHT_ANGLE = Math.PI / 2;
      const HEAD_BONE_NAMES = ["head", "cc_base_head", "cc_base_headnode"];
      const camera = scene.activeCamera;
      if (!camera || !avatarRoot) return false;

      const projectToGround = v => new BABYLON.Vector3(v.x, 0, v.z);
      const normalizeGround = v => {
        const g = projectToGround(v);
        const len = g.length();
        return len < 0.0001 ? null : g.scale(1 / len);
      };
      const signedYaw = (from, to) => {
        const crossY = from.x * to.z - from.z * to.x;
        return Math.atan2(crossY, BABYLON.Vector3.Dot(from, to));
      };
      const findHeadPosition = () => {
        const wanted = new Set(HEAD_BONE_NAMES);
        for (const sk of scene.skeletons) {
          for (const bone of sk.bones) {
            if (!wanted.has(bone.name.toLowerCase())) continue;
            const node = boneTransformNode(bone);
            if (node) return node.getAbsolutePosition();
          }
        }
        return null;
      };
      const findEyeCenter = () => {
        const eyeMeshes = avatarRoot.getChildMeshes(false).filter(m => {
          const n = m.name.toLowerCase();
          return m.isEnabled() && n.includes("eye") && !n.includes("eyelash");
        });
        if (!eyeMeshes.length) return null;
        const center = BABYLON.Vector3.Zero();
        for (const m of eyeMeshes) {
          m.computeWorldMatrix(true);
          center.addInPlace(m.getBoundingInfo().boundingBox.centerWorld);
        }
        return center.scale(1 / eyeMeshes.length);
      };
      const inferForward = () => {
        const head = findHeadPosition();
        const eye = findEyeCenter();
        if (head && eye) {
          const f = normalizeGround(head.subtract(eye));
          if (f) return { forward: f, source: "eyes-to-head" };
        }
        avatarRoot.computeWorldMatrix(true);
        const f = normalizeGround(BABYLON.Vector3.TransformNormal(BABYLON.Vector3.Forward(), avatarRoot.getWorldMatrix()));
        return f ? { forward: f, source: "avatar-forward-axis" } : null;
      };

      avatarRoot.computeWorldMatrix(true);
      const toCamera = normalizeGround(camera.position.subtract(avatarRoot.getAbsolutePosition()));
      const inferred = inferForward();
      if (!toCamera || !inferred) {
        console.warn("[Avatar] could not infer orientation for camera-facing snap");
        return false;
      }
      const rawYaw = signedYaw(inferred.forward, toCamera);
      const snappedYaw = Math.round(rawYaw / RIGHT_ANGLE) * RIGHT_ANGLE;
      if (Math.abs(snappedYaw) < 0.0001) {
        console.log("[Avatar] camera-facing snap: already facing camera", inferred.source);
        return true;
      }
      avatarRoot.rotate(BABYLON.Axis.Y, snappedYaw, BABYLON.Space.WORLD);
      avatarRoot.computeWorldMatrix(true);
      console.log("[Avatar] camera-facing snap:", inferred.source, "deg:", BABYLON.Tools.ToDegrees(snappedYaw));
      return true;
    }

    async function initializeBabylonScene() {
      const canvas = document.getElementById("renderCanvas");

      engine = new BABYLON.Engine(canvas, true, {
        preserveDrawingBuffer: true,
        stencil: true,
        antialias: true,
        powerPreference: "high-performance"
      });
      engine.setHardwareScalingLevel(RENDER_CONFIG.hardwareScalingLevel);

      scene = new BABYLON.Scene(engine);
      scene.clearColor = BABYLON.Color4.FromHexString(RENDER_CONFIG.clearColor);

      // Enable animation interpolation for smooth seeking
      BABYLON.Animation.AllowMatricesInterpolation = true;

      // Studio lighting rig (env IBL + sun shadows + hemi fill + three-point spots).
      // Replaces the old flat hemispheric + directional setup.
      lightingRig = setupLighting(scene);

      // Add ArcRotateCamera - framed to show hips to head (framing later refined by
      // focusCameraOnAvatar once the avatar's spine bone is available)
      camera = new BABYLON.ArcRotateCamera(
        "camera",
        Math.PI / 2,      // alpha: horizontal angle (front view)
        Math.PI / 2,      // beta: vertical angle (straight on)
        1.2,              // radius: distance from target (closer for tighter framing)
        new BABYLON.Vector3(0, 1.3, 0),  // target: upper chest/neck area
        scene
      );
      camera.attachControl(canvas, true);
      camera.wheelDeltaPercentage = 0.015;
      camera.panningSensibility = 0;
      camera.minZ = 0.01;  // Fix near clipping when zoomed in close
      camera.lowerRadiusLimit = 0.5;
      camera.upperRadiusLimit = 10;

      // Hand-follow loop: while a hand is locked, keep the camera aimed at it
      // (preserving the user's current orbit). Mirrors BabylonCC App.tsx.
      scene.onBeforeRenderObservable.add(() => {
        if (!trackedHand || !avatarRoot) return;
        const names = trackedHand === "left" ? HAND_TRACKING.leftBoneNames : HAND_TRACKING.rightBoneNames;
        focusCameraOnAvatarBone(scene, avatarRoot, names, {
          targetOffset: HAND_TRACKING.targetOffset,
          preserveOrbit: true,
          silent: true,
        });
      });

      // Run render loop
      engine.runRenderLoop(() => {
        scene.render();
      });

      // Handle window resize
      window.addEventListener("resize", () => {
        engine.resize();
      });

      // ---- Dev helper: tune framing live, then copy it back to the config. ----
      // Orbit/zoom the avatar to taste, then in the browser console run: dumpView()
      // Paste the printed block to lock it in as AVATAR_CAMERA_CONFIG.
      window.camera = camera;
      window.scene = scene;
      window.dumpView = () => {
        const t = camera.getTarget();
        const view = {
          alpha: +camera.alpha.toFixed(4),
          beta: +camera.beta.toFixed(4),
          radius: +camera.radius.toFixed(4),
          target: { x: +t.x.toFixed(4), y: +t.y.toFixed(4), z: +t.z.toFixed(4) },
          canvasAspect: +(engine.getRenderWidth() / engine.getRenderHeight()).toFixed(4),
        };
        console.log("[View] copy this to me:\n" + JSON.stringify(view, null, 2));
        return view;
      };

      console.log("Babylon.js scene initialized");
    }

    // ============================================
    // CHARACTER CONTROLLER (from blendAnims pattern)
    // ============================================

    // Helper: Focus camera on mesh bounds
    function focusCameraOnMesh(meshes) {
      if (!meshes || meshes.length === 0) return;

      let min = new BABYLON.Vector3(Infinity, Infinity, Infinity);
      let max = new BABYLON.Vector3(-Infinity, -Infinity, -Infinity);

      meshes.forEach(mesh => {
        if (mesh.getBoundingInfo()) {
          const meshMin = mesh.getBoundingInfo().boundingBox.minimumWorld;
          const meshMax = mesh.getBoundingInfo().boundingBox.maximumWorld;
          min = BABYLON.Vector3.Minimize(min, meshMin);
          max = BABYLON.Vector3.Maximize(max, meshMax);
        }
      });

      const center = BABYLON.Vector3.Center(min, max);
      const camera = scene.activeCamera;
      if (camera) {
        camera.setTarget(center);
        const size = max.subtract(min);
        const maxDim = Math.max(size.x, size.y, size.z);
        camera.radius = maxDim * 2;
        camera.lowerRadiusLimit = maxDim * 0.5;
        camera.upperRadiusLimit = maxDim * 4;
      }
    }

    // Helper: Get morph target index by name
    function getMorphTargetIndex(morphTargetManager, targetName) {
      if (!morphTargetManager) return -1;
      for (let i = 0; i < morphTargetManager.numTargets; i++) {
        if (morphTargetManager.getTarget(i).name === targetName) {
          return i;
        }
      }
      return -1;
    }

    // Helper: Normalize bone name for matching (handle different naming conventions)
    function normalizeBoneName(name) {
      if (!name) return name;
      // Strip common prefixes like "Armature|"
      if (name.includes("|")) {
        return name.split("|").pop();
      }
      // Handle mixamo prefix
      if (name.startsWith("mixamorig:")) {
        return name.replace("mixamorig:", "");
      }
      return name;
    }

    // Key function: Retarget animation to base character (from blendAnims)
    function retargetAnimWithBlendshapes(animGroup, cloneName) {
      let curMTM = 0;
      let morphName = "";
      let morphIndex = -1;
      let mtm = null;
      let boneMatches = 0;
      let morphMatches = 0;
      let noMatches = 0;

      console.log("=== Starting Retarget ===");
      console.log("Skeleton:", skeleton ? "loaded" : "NOT LOADED");
      console.log("Skeleton bones count:", skeleton?.bones?.length || 0);
      console.log("Morph target managers:", morphTargetManagers.length);

      // Log first 5 bone names from skeleton for reference
      if (skeleton && skeleton.bones) {
        console.log("First 5 skeleton bone names:", skeleton.bones.slice(0, 5).map(b => b.name));
        // Check linkedTransformNode status
        const bonesWithLinks = skeleton.bones.filter(b => b._linkedTransformNode).length;
        console.log(`Bones with linkedTransformNode: ${bonesWithLinks}/${skeleton.bones.length}`);
        if (bonesWithLinks === 0) {
          console.error("CRITICAL: No bones have _linkedTransformNode - retargeting will fail!");
        }
      }

      // Analyze source animation
      const boneAnims = animGroup.targetedAnimations.filter(ta =>
        ta.animation?.targetProperty !== 'influence');
      const morphAnims = animGroup.targetedAnimations.filter(ta =>
        ta.animation?.targetProperty === 'influence');
      console.log(`Source animation: ${boneAnims.length} bone anims, ${morphAnims.length} morph anims`);

      if (boneAnims.length > 0) {
        console.log("First 5 bone animation targets:", boneAnims.slice(0, 5).map(ta => ta.target?.name));
      } else {
        console.log("First 5 animation targets:", animGroup.targetedAnimations.slice(0, 5).map(ta => ta.target?.name));
      }

      // Resolve a source animation target to a node on the base character.
      // Returns null when there's no match so we can SKIP it. Adding a
      // null-target animation (which AnimationGroup.clone does) crashes Babylon's
      // RuntimeAnimation ("Cannot read properties of null (reading 'position')")
      // the moment the group is started/seeked — exactly what broke timeline
      // hover after the animation character was switched.
      const resolveTarget = (target) => {
        if (!target) return null;

        // Step 1: Try to map skeletal bone animations
        if (skeleton) {
          // Try exact match first
          let boneIdx = skeleton.getBoneIndexByName(target.name);

          // If not found, try normalized name (strip prefixes)
          if (boneIdx === -1) {
            const normalizedName = normalizeBoneName(target.name);
            if (normalizedName !== target.name) {
              boneIdx = skeleton.getBoneIndexByName(normalizedName);
            }
          }

          if (boneIdx !== -1) {
            const targetBone = skeleton.bones[boneIdx];
            if (targetBone && targetBone._linkedTransformNode) {
              boneMatches++;
              return targetBone._linkedTransformNode;
            }
          }
        }

        // Step 2: Map morph target (blendshape) animations
        if (morphTargetManagers.length > 0) {
          if (morphName !== target.name) {
            curMTM = 0;
            morphName = target.name;
          }

          if (curMTM < morphTargetManagers.length) {
            morphIndex = getMorphTargetIndex(morphTargetManagers[curMTM], target.name);

            if (morphIndex !== -1) {
              mtm = morphTargetManagers[curMTM].getTarget(morphIndex);
              curMTM++;
              morphMatches++;
              return mtm;
            }
          }
        }

        noMatches++;
        return null; // no match — skip it (never add a null-target animation)
      };

      // Build the retargeted group manually so unmatched targets are dropped
      // rather than added with a null target.
      const clonedAnimGroup = new BABYLON.AnimationGroup(cloneName, scene);
      animGroup.targetedAnimations.forEach((ta) => {
        if (!ta.animation) return;
        const newTarget = resolveTarget(ta.target);
        if (!newTarget) return;

        const anim = ta.animation.clone();
        // CC skeleton is in centimetres but FBX→GLB animations export positions in metres,
        // so scale position keys by POS_SCALE (rotation/morph keys are unaffected).
        if (anim.targetProperty === "position" && POS_SCALE !== 1) {
          anim.setKeys(anim.getKeys().map(k => {
            const v = k.value;
            return (v && v.x !== undefined)
              ? { frame: k.frame, value: new BABYLON.Vector3(v.x * POS_SCALE, v.y * POS_SCALE, v.z * POS_SCALE) }
              : k;
          }));
        }
        clonedAnimGroup.addTargetedAnimation(anim, newTarget);
      });

      console.log(`Retarget complete: ${boneMatches} bone matches, ${morphMatches} morph matches, ${noMatches} no matches, ${clonedAnimGroup.targetedAnimations.length} added`);

      clonedAnimGroup.name = cloneName;
      return clonedAnimGroup;
    }

    // Load base character mesh (skeleton + morph targets)
    async function loadBaseCharacter() {
      zinDisplayElement.textContent = 'Loading base character...';

      try {
        const loadedResults = await BABYLON.SceneLoader.ImportMeshAsync(
          null,
          BASE_CHARACTER_URL,
          "",
          scene
        );

        character = loadedResults;
        skeleton = loadedResults.skeletons[0];

        // Wrap the imported top-level nodes under a single root TransformNode so the
        // camera-focus, hand-follow and orientation-snap helpers have something to target
        // (mirrors BabylonCC loadAvatar.ts). We KEEP the CC avatar's 0.01 root scaling
        // (it renders at ~metre scale, matching this tool's camera); position animations
        // are scaled by POS_SCALE during retargeting to compensate. Do NOT rescale to 1.0.
        avatarRoot = new BABYLON.TransformNode("Avatar", scene);
        const importedNodes = [...loadedResults.transformNodes, ...loadedResults.meshes];
        const importedSet = new Set(importedNodes);
        importedNodes
          .filter(n => n !== avatarRoot && (!n.parent || !importedSet.has(n.parent)))
          .forEach(n => { n.parent = avatarRoot; });


        // CC avatar handling (mirrors babyloncc/dist): hide helper meshes and tune
        // materials via the ported AVATAR_MATERIAL_CONFIG / AVATAR_MATERIAL_RULES.
        const RULES = AVATAR_MATERIAL_RULES;
        loadedResults.meshes.forEach(mesh => {
          mesh.alwaysSelectAsActiveMesh = true;

          // Hide CC helper meshes that should never render (eye occlusion, tear line, ...)
          const lower = mesh.name.toLowerCase();
          if (EXCLUDED.some(ex => lower.includes(ex.toLowerCase()))) {
            mesh.setEnabled(false);
            return;
          }

          const mat = mesh.material;
          if (!mat) return;
          const name = (mesh.name + " " + mat.name).toLowerCase();

          // Base studio material tuning
          mat.specularIntensity = AVATAR_MATERIAL_CONFIG.specularIntensity;
          mat.environmentIntensity = AVATAR_MATERIAL_CONFIG.environmentIntensity;
          mat.roughness = AVATAR_MATERIAL_CONFIG.roughness;
          mat.metallic = AVATAR_MATERIAL_CONFIG.metallic;

          const alphaBlendRule = RULES.alphaBlendRules.find(r => r.nameIncludes.some(t => name.includes(t)));
          const roughnessRule = RULES.roughnessOverrides.find(r => r.nameIncludes.some(t => name.includes(t)));

          if (alphaBlendRule) {
            if (typeof alphaBlendRule.backFaceCulling === "boolean") mat.backFaceCulling = alphaBlendRule.backFaceCulling;
            if (typeof alphaBlendRule.renderingGroupId === "number") mesh.renderingGroupId = alphaBlendRule.renderingGroupId;
            mat.transparencyMode = BABYLON.PBRMaterial.PBRMATERIAL_ALPHABLEND;
          } else if (roughnessRule) {
            mat.roughness = Math.max(mat.roughness, roughnessRule.minimumRoughness);
          } else if (RULES.scalp.nameIncludes.some(t => name.includes(t))) {
            mesh.renderingGroupId = RULES.scalp.renderingGroupId;
            mesh.alphaIndex = RULES.scalp.alphaIndex;
          } else if (RULES.opaqueFallback) {
            mat.transparencyMode = BABYLON.PBRMaterial.PBRMATERIAL_OPAQUE;
          }
        });

        // Register visible avatar meshes as shadow casters for the studio lights
        if (lightingRig) {
          loadedResults.meshes.forEach(mesh => {
            if (mesh.isEnabled() && mesh.getTotalVertices && mesh.getTotalVertices() > 0) {
              lightingRig.addShadowCaster(mesh);
            }
          });
        }

        // Extract morph target managers (for facial animations)
        morphTargetManagers = loadedResults.meshes
          .filter(mesh => mesh.morphTargetManager)
          .map(mesh => mesh.morphTargetManager);

        console.log("=== Base Character Loaded ===");
        console.log("Skeleton bones:", skeleton ? skeleton.bones.length : 0);
        console.log("Morph target managers:", morphTargetManagers.length);

        // Verify linkedTransformNode setup
        if (skeleton) {
          const bonesWithLinks = skeleton.bones.filter(b => b._linkedTransformNode).length;
          console.log(`Bones with linkedTransformNode: ${bonesWithLinks}/${skeleton.bones.length}`);
          if (bonesWithLinks > 0) {
            console.log("First bone with linkedTransformNode:",
              skeleton.bones.find(b => b._linkedTransformNode)?.name);
          }
        }

        // Frame the camera on the avatar's spine bone (BabylonCC camera-focus config),
        // then rotate the avatar so its eyes actually face that camera, then re-frame.
        focusCameraOnAvatar(scene, avatarRoot);
        orientAvatarEyesToCamera(scene, avatarRoot);
        // Optional manual fine-tune on top of the automatic eye-facing (default 0).
        if (AVATAR_CAMERA_CONFIG.facingYDegrees) {
          avatarRoot.rotate(BABYLON.Axis.Y, BABYLON.Tools.ToRadians(AVATAR_CAMERA_CONFIG.facingYDegrees), BABYLON.Space.WORLD);
        }
        focusCameraOnAvatar(scene, avatarRoot);

        baseCharacterLoaded = true;
        zinDisplayElement.textContent = 'Base character loaded. Load an animation GLB...';

      } catch (error) {
        console.error("Error loading base character:", error);
        zinDisplayElement.textContent = 'Error loading base character: ' + error.message;
        baseCharacterLoaded = false;
      }
    }

    // ============================================
    // ANIMATION GLB LOADING (with retargeting)
    // ============================================
    async function loadAnimationGLB(glbPath) {
      if (!baseCharacterLoaded) {
        alert("Please wait for base character to load first");
        return;
      }

      zinDisplayElement.textContent = 'Loading animation...';

      // Dispose previous animation (but keep base character)
      if (currentAnimationGroup) {
        currentAnimationGroup.dispose();
        currentAnimationGroup = null;
      }

      try {
        // Import animations and use result object (like compare.html does)
        const importResult = await BABYLON.SceneLoader.ImportAnimationsAsync(
          "",
          glbPath,
          scene,
          false,  // don't overwrite existing animations
          BABYLON.SceneLoaderAnimationGroupLoadingMode.NoSync
        );

        console.log("Animation imported, groups:", scene.animationGroups.length);

        // Find the animation group from result or scene (with fallback)
        let sourceAnimation = null;
        const animGroups = importResult.animationGroups || scene.animationGroups;

        for (let i = animGroups.length - 1; i >= 0; i--) {
          if (animGroups[i].name === "Unreal Take") {
            sourceAnimation = animGroups[i];
            break;
          }
        }

        // Fallback: use the last added animation group
        if (!sourceAnimation && animGroups.length > 0) {
          sourceAnimation = animGroups[animGroups.length - 1];
        }

        if (!sourceAnimation) {
          zinDisplayElement.textContent = 'No animation found in GLB';
          console.warn("No animation groups found in GLB");
          return;
        }

        console.log("=== Source Animation Analysis ===");
        console.log("Source animation:", sourceAnimation.name);
        console.log("Source frame range:", sourceAnimation.from, "to", sourceAnimation.to);
        console.log("Targeted animations count:", sourceAnimation.targetedAnimations.length);

        // Analyze animation types
        const boneAnims = sourceAnimation.targetedAnimations.filter(ta =>
          ta.animation?.targetProperty !== 'influence');
        const morphAnims = sourceAnimation.targetedAnimations.filter(ta =>
          ta.animation?.targetProperty === 'influence');
        console.log(`Animation breakdown: ${boneAnims.length} bone anims, ${morphAnims.length} morph anims`);

        // Retarget animation to base character FIRST
        const animName = glbPath.split('/').pop().replace('.glb', '').replace('.gltf', '');
        currentAnimationGroup = retargetAnimWithBlendshapes(sourceAnimation, animName);

        // Dispose the original (non-retargeted) animation
        sourceAnimation.dispose();

        // Get frame range from the RETARGETED animation group
        console.log("Retargeted animation:", currentAnimationGroup.name);
        console.log("Retargeted frame range:", currentAnimationGroup.from, "to", currentAnimationGroup.to);

        // Use the retargeted animation's from/to values
        animationFromFrame = currentAnimationGroup.from;
        animationToFrame = currentAnimationGroup.to;

        // Extract frame rate from animation (default 30, but use actual if available)
        const firstAnim = currentAnimationGroup.targetedAnimations.find(ta => ta.animation);
        if (firstAnim && firstAnim.animation.framePerSecond) {
          animationFrameRate = firstAnim.animation.framePerSecond;
          console.log("Detected animation frame rate:", animationFrameRate);
        }

        // If still 0, try to get from the animation keys
        if (animationFromFrame === 0 && animationToFrame === 0) {
          console.log("Retargeted animation has 0 range, analyzing all animations...");
          animationFromFrame = Infinity;

          // Group animations by type for debugging
          let boneAnimCount = 0, morphAnimCount = 0, maxKeys = 0;

          currentAnimationGroup.targetedAnimations.forEach((ta, index) => {
            if (ta.animation) {
              const keys = ta.animation.getKeys();
              const targetName = ta.target?.name || 'unknown';
              const prop = ta.animation.targetProperty;
              const fps = ta.animation.framePerSecond;

              // Track animation types
              if (prop === 'influence') {
                morphAnimCount++;
              } else {
                boneAnimCount++;
              }

              if (keys && keys.length > maxKeys) {
                maxKeys = keys.length;
              }

              // Log first few bone animations (not morph)
              if (prop !== 'influence' && boneAnimCount <= 5) {
                console.log(`Bone anim: ${targetName}.${prop}, keys: ${keys?.length || 0}, fps: ${fps}`);
                if (keys && keys.length > 0) {
                  console.log(`  First key frame: ${keys[0].frame}, Last key frame: ${keys[keys.length-1].frame}`);
                }
              }

              if (keys && keys.length > 1) {
                const firstFrame = keys[0].frame;
                const lastFrame = keys[keys.length - 1].frame;
                if (firstFrame < animationFromFrame) {
                  animationFromFrame = firstFrame;
                }
                if (lastFrame > animationToFrame) {
                  animationToFrame = lastFrame;
                }
              }
            }
          });

          console.log(`Animation breakdown: ${boneAnimCount} bone anims, ${morphAnimCount} morph anims, max keys per anim: ${maxKeys}`);

          if (animationFromFrame === Infinity) {
            animationFromFrame = 0;
          }
          console.log("Extracted frame range:", animationFromFrame, "to", animationToFrame);
        }

        // Stop auto-play, we control manually
        currentAnimationGroup.stop();
        currentAnimationGroup.goToFrame(animationFromFrame);

        // Calculate duration
        animationDuration = (animationToFrame - animationFromFrame) / animationFrameRate;

        // Ensure minimum duration
        if (animationDuration <= 0) {
          console.warn("Animation duration is 0 or negative, setting default of 5 seconds");
          animationDuration = 5; // fallback
          animationToFrame = animationFrameRate * 5; // 5 seconds worth of frames
        }

        console.log("Final duration:", animationDuration, "seconds");

        isAnimationLoaded = true;
        currentTime = 0;

        // Update timeline
        updateTimelineWidth();
        renderTimeRuler();
        renderAll();

        // Fetch sentence from server using base filename
        const filenameMatch = animName.match(/M\d{8}_\d{4}/);
        if (filenameMatch) {
          try {
            const zinResponse = await fetch(`getZinnen.php?action=fetchZinArrayByFilename&filename=${encodeURIComponent(filenameMatch[0] + '.wav')}`);
            const zinData = await zinResponse.json();
            if (zinData.success && zinData.zinArray) {
              currentZinArray = zinData.zinArray;
              zinDisplayElement.textContent = currentZinArray.join(' ');
              currentSentenceRowId = zinData.sentenceRowId || null;
              const mcpP = document.getElementById('mcpStatusPostprocessing');
              const mcpG = document.getElementById('mcpStatusTijdAnnotatie');
              const mcpGvg = document.getElementById('mcpStatusTijdAnnotatieGvg');
              if (mcpP) mcpP.value = zinData.mcp_status_postprocessing || 'Niet Klaar';
              if (mcpG) mcpG.value = zinData.mcp_status_tijd_annotatie || '';
              if (mcpGvg) mcpGvg.value = zinData.mcp_status_tijd_annotatie_gvg || '';
            } else {
              zinDisplayElement.textContent = 'Animation: ' + animName;
            }
          } catch (err) {
            console.error('Error fetching sentence:', err);
            zinDisplayElement.textContent = 'Animation: ' + animName;
          }
        } else {
          zinDisplayElement.textContent = 'Animation: ' + animName;
        }

      } catch (error) {
        console.error("Error loading animation GLB:", error);
        zinDisplayElement.textContent = 'Error loading animation: ' + error.message;
        isAnimationLoaded = false;
      }
    }

    // Legacy function name for compatibility
    async function loadGLBAnimation(glbPath) {
      return loadAnimationGLB(glbPath);
    }

    // ============================================
    // ANIMATION SEEKING (replaces drawFrame)
    // ============================================
    function seekAnimation(time) {
      if (!currentAnimationGroup || !isAnimationLoaded) return;

      // Clamp time to valid range
      time = Math.max(0, Math.min(time, animationDuration));

      // Convert time to frame number using stored frame range
      const targetFrame = animationFromFrame + (time * animationFrameRate);

      // goToFrame only works if animation has been started
      // Start and immediately pause to enable seeking (like compare.html does)
      if (!currentAnimationGroup.isPlaying) {
        currentAnimationGroup.start(false, 1.0, animationFromFrame, animationToFrame, false);
        currentAnimationGroup.pause();
      }

      // Seek animation to frame
      currentAnimationGroup.goToFrame(targetFrame);

      // Update time display
      document.getElementById('videoTimeDisplay').textContent = time.toFixed(2);
    }

    function setCanvasTime(time, who) {
      // Clamp time within animation duration bounds
      currentTime = Math.max(0, Math.min(time, animationDuration));
      seekAnimation(currentTime);
      updateSubtitleTrack();
      updateCurrentTimeArrow();
    }


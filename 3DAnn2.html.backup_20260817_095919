      subtitles.forEach(s => {
        if (s.tier === sub.tier && s.id !== sub.id && s.end <= sub.end && s.end > leftLimit) leftLimit = s.end;
      });
      newStart = Math.max(leftLimit, newStart);
      newStart = Math.max(0, Math.min(newStart, sub.end - 0.01));
      sub.start = newStart;

    function updateThreeCanvases(sub) {
        if (!sub) return;
        canvasLeft.style.display = 'block';
        captureSceneToCanvas(ctxLeft, sub.start);
        canvasRight.style.display = 'block';
        captureSceneToCanvas(ctxRight, sub.end);
        setSideCaps(true);
    }

    function onEndThreeCanvases() {

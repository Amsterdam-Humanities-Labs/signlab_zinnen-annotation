    // ============================================
    // SELECTION + KEYBOARD EDITING (ported from subBeta8)
    // ============================================
    function getSelectedSub() { return subtitles.find(s => s.id === selectedSubId) || null; }
    function applySelectionHighlight() {
      document.querySelectorAll('.subtitle-box').forEach(b => {
        b.classList.toggle('selected-sub', String(b.dataset.id) === String(selectedSubId));
      });
    }
    function selectSub(id, opts = {}) {
      selectedSubId = id;
      applySelectionHighlight();
      const sub = getSelectedSub();
      if (sub) {
        if (opts.snapPlayhead) setCanvasTime(sub.start, 'select');
        const box = document.querySelector('.subtitle-box[data-id="' + id + '"]');
        if (box && box.scrollIntoView) box.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        updateThreeCanvases(sub);
      }
    }
    function updateTwinBox(s) {
      const tw = s.cloneId ? subtitles.find(x => x.id === s.cloneId)
               : s.masterId ? subtitles.find(x => x.id === s.masterId) : null;
      if (tw) updateSubtitleBoxDimensions(tw);
    }
    function enterEditMode(box) {
      if (!box) return;
      const c = box.querySelector('.content');
      if (!c) return;
      c.contentEditable = true;
      c.focus();
      const range = document.createRange();
      range.selectNodeContents(c);
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    }
    // Nudge helpers. Step = one animation frame; boundaries freeze against locked
    // neighbours on the same tier (never push or overlap them).
    function stepSize() { return 1 / (animationFrameRate || 30); }
    function snapStep(t) { const s = stepSize(); return Math.round(t / s) * s; }
    function nudgeLeftBoundary(sub, frames) {
      const step = stepSize();
      let ns = snapStep(sub.start + frames * step);
      let leftLimit = 0;
      subtitles.forEach(s => {
        if (s.tier === sub.tier && s.id !== sub.id && s.end <= sub.end && s.end > leftLimit) leftLimit = s.end;
      });
      ns = Math.max(leftLimit, ns);
      ns = Math.max(0, Math.min(ns, sub.end - step));
      sub.start = ns;
      updateSubtitleBoxDimensions(sub); syncTwin(sub); updateTwinBox(sub);
      setCanvasTime(sub.start, 'keyboard'); updateThreeCanvases(sub); uploadSubtitles();
    }
    function nudgeRightBoundary(sub, frames) {
      const step = stepSize();
      let ne = snapStep(sub.end + frames * step);
      let rightLimit = animationDuration;
      subtitles.forEach(s => {
        if (s.tier === sub.tier && s.id !== sub.id && s.start >= sub.start && s.start < rightLimit) rightLimit = s.start;
      });
      ne = Math.min(rightLimit, ne);
      ne = Math.min(animationDuration, Math.max(ne, sub.start + step));
      sub.end = ne;
      updateSubtitleBoxWidth(sub); syncTwin(sub); updateTwinBox(sub);
      setCanvasTime(sub.end, 'keyboard'); updateThreeCanvases(sub); uploadSubtitles();
    }
    function nudgeWholeBlock(sub, frames) {
      const step = stepSize();
      const len = sub.end - sub.start;
      let ns = snapStep(sub.start + frames * step);
      let leftLimit = 0, rightLimit = animationDuration;
      subtitles.forEach(s => {
        if (s.tier !== sub.tier || s.id === sub.id) return;
        if (s.end <= sub.start && s.end > leftLimit) leftLimit = s.end;
        if (s.start >= sub.end && s.start < rightLimit) rightLimit = s.start;
      });
      ns = Math.max(leftLimit, Math.min(ns, rightLimit - len));
      ns = Math.max(0, Math.min(ns, animationDuration - len));
      sub.start = ns; sub.end = ns + len;
      updateSubtitleBoxDimensions(sub); syncTwin(sub); updateTwinBox(sub);
      setCanvasTime(sub.start, 'keyboard'); updateThreeCanvases(sub); uploadSubtitles();
    }

    // ============================================
    // DRAGGING
    // ============================================
    let dragActive = false, dragId = null, dragStartX = 0, dragStartY = 0, origStart = 0, origTier = 0, duration = 0;

    function initDrag(e, id) {
      const sub = subtitles.find(s => s.id === id);
      e.stopPropagation();
      dragActive = true;
      dragId = id;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      origStart = sub.start;
      origTier = sub.tier;
      duration = sub.end - sub.start;
      busyMoving = 1;
      document.addEventListener('mousemove', onDrag);
      document.addEventListener('mouseup', endDrag);
      e.preventDefault();
    }

    function onDrag(e) {
      if (!dragActive) return;
      const sub = subtitles.find(s => s.id === dragId);
      let dx = e.clientX - dragStartX, dy = e.clientY - dragStartY;
      // Update tier first so neighbour lookups use the destination tier
      let newTier = origTier + Math.round(dy / TIER_HEIGHT);
      sub.tier = Math.min(Math.max(0, newTier), 2);
      let newStart = origStart + pxToTime(dx);
      newStart = Math.max(0, Math.min(newStart, animationDuration - duration));
      // Freeze against same-tier neighbours: confine the box to its current gap
      // (neighbours stay locked in place; the dragged box stops when it touches one)
      let leftLimit = 0, rightLimit = animationDuration;
      subtitles.forEach(s => {
        if (s.tier !== sub.tier || s.id === sub.id) return;
        if (s.end <= sub.start && s.end > leftLimit) leftLimit = s.end;
        if (s.start >= sub.end && s.start < rightLimit) rightLimit = s.start;
      });
      newStart = Math.max(leftLimit, Math.min(newStart, rightLimit - duration));
      newStart = Math.max(0, Math.min(newStart, animationDuration - duration));
      sub.start = newStart;
      sub.end = newStart + duration;
      syncTwin(sub);
      updateSubtitleBoxDimensions(sub);
      if (sub.cloneId) {
        const twin = subtitles.find(s => s.id === sub.cloneId);
        if (twin) updateSubtitleBoxDimensions(twin);
      } else if (sub.masterId) {
        const master = subtitles.find(s => s.id === sub.masterId);
        if (master) updateSubtitleBoxDimensions(master);
      }
      const rect = timelineContainer.getBoundingClientRect();
      const newTime = pxToTime(e.clientX - rect.left);
      setCanvasTime(newTime, "drag");
      updateThreeCanvases(sub);
      hideVideoPreview();
      uploadSubtitles();
    }

    function endDrag() {
      dragActive = false;
      dragId = null;
      document.removeEventListener('mousemove', onDrag);
      document.removeEventListener('mouseup', endDrag);
      onEndThreeCanvases();
      uploadSubtitles();
    }


    timelineContainer.addEventListener('scroll', () => {
      if (isSyncingScroll) return;
      isSyncingScroll = true;
      customScrollbar.scrollLeft = timelineContainer.scrollLeft;
      isSyncingScroll = false;
    });

    customScrollbar.addEventListener('scroll', () => {
      if (isSyncingScroll) return;
      isSyncingScroll = true;
      timelineContainer.scrollLeft = customScrollbar.scrollLeft;
      isSyncingScroll = false;
    });

    // ============================================
    // VJEPA AUTO-SEGMENT (re-time the Signbank ID glossen tier)
    // ============================================
    // The recorded animations always contain the same signs but with slightly
    // different timings each re-capture. Auto-Segment re-runs the VJEPA sign
    // segmenter on the rendered mp4 and snaps the Signbank ID glossen boxes
    // (tier 2 only) onto the freshly detected boundaries, keeping their text.
    // Auto-Segment 2D does the same from the razer RIGHT studio recording
    // (covers animations without a record3D render); its timeline is anchored
    // to the first Signbank box since the recording starts before the signing.
    const SEG_BASE = (location.hostname === 'localhost' || location.hostname === '127.0.0.1')
      ? 'http://localhost:8001' : 'https://signcollect.nl/sign-segmenter';
    const SIGNBANK_TIER = 2;          // "Signbank ID glossen"
    let autoSegSnapshot = null;       // deep copy of subtitles before the first Auto-Segment

    // Basename of the loaded animation, from ?glb= (or ?filename=).
    function animBasename() {
      const params = new URLSearchParams(window.location.search);
      const glbParam = params.get('glb') || '';
      if (glbParam) return glbParam.split('/').pop().replace(/\.[^.]+$/, '');
      return (params.get('filename') || '').replace(/\.[^.]+$/, '');
    }

    // The render lives at /zin/record3D/out/<basename>.mp4.
    function autoSegVideoUrl() {
      const base = animBasename();
      if (!base) return null;
      return 'record3D/out/' + encodeURIComponent(base) + '.mp4';
    }

    // The 2D studio stream of the same capture lives in razerFiles with an
    // unpredictable timestamp suffix; getRazerVideo.php globs it for us.
    async function razerVideoUrl() {
      const base = animBasename();
      if (!base) return null;
      const r = await fetch('getRazerVideo.php?base=' + encodeURIComponent(base) + '&view=RIGHT');
      if (!r.ok) return null;
      const data = await r.json();
      return data.success ? data.url : null;
    }

    async function fetchSegments(videoUrl) {
      const vidResp = await fetch(videoUrl);
      if (!vidResp.ok) throw new Error('video HTTP ' + vidResp.status);
      const blob = await vidResp.blob();                 // segmenter auto-converts fps server-side
      const r = await fetch(SEG_BASE + '/segment', { method: 'POST', body: blob });
      if (!r.ok) throw new Error('segment HTTP ' + r.status);
      const data = await r.json();
      const segs = Array.isArray(data.segments) ? data.segments : [];
      return segs.map(([s, e]) => ({ start: +s, end: +e }))
                 .sort((a, b) => a.start - b.start);
    }

    async function runAutoSegment(btnId, getVideoUrl, alignToTier) {
      const btn = document.getElementById(btnId);
      const otherBtn = document.getElementById(btnId === 'autoSegBtn' ? 'autoSeg2DBtn' : 'autoSegBtn');
      const revertBtn = document.getElementById('revertAutoSegBtn');

      const origLabel = btn.textContent;
      btn.disabled = true; otherBtn.disabled = true; btn.textContent = 'Segmenting…';
      try {
        const videoUrl = await getVideoUrl();
        if (!videoUrl) { showToast('No recorded video found for this animation', 'error', 4000); return; }
        const segs = await fetchSegments(videoUrl);
        if (!segs.length) { showToast('Segmenter returned no segments', 'error', 4000); return; }

        // Snapshot the original timings once, so Revert always returns to the
        // pre-Auto-Segment state even across repeated runs.
        if (!autoSegSnapshot) autoSegSnapshot = JSON.parse(JSON.stringify(subtitles));

        // Re-time ONLY the Signbank ID glossen tier. Override each existing box's
        // timing with the matching detected segment (keeping its text), then append
        // any extra detected segments as new empty boxes.
        const boxes = subtitles.filter(s => s.tier === SIGNBANK_TIER)
                               .sort((a, b) => a.start - b.start);

        // The 2D razer recordings start before the signing does, so their timeline
        // is offset from the (trimmed) animation by an unknown constant. Shift all
        // detected segments so the first one starts where the first Signbank box
        // starts; relative timings from the 2D video are preserved exactly.
        if (alignToTier) {
          const anchor = boxes.length ? boxes[0].start : 0;
          const shift = anchor - segs[0].start;
          for (const s of segs) {
            s.start = Math.round((s.start + shift) * 1000) / 1000;
            s.end = Math.round((s.end + shift) * 1000) / 1000;
          }
        }

        const n = Math.min(boxes.length, segs.length);
        for (let i = 0; i < n; i++) {
          boxes[i].start = segs[i].start;
          boxes[i].end = segs[i].end;
        }
        let added = 0;
        for (let i = n; i < segs.length; i++) {
          uniqueId++;
          subtitles.push({ id: 'autoseg_' + uniqueId, text: '', start: segs[i].start, end: segs[i].end, tier: SIGNBANK_TIER, committed: true });
          added++;
        }

        renderAll();
        uploadSubtitles();
        revertBtn.disabled = false;

        let msg = `Re-timed ${n} Signbank sign(s)`;
        if (added) msg += `, added ${added} new segment(s)`;
        if (boxes.length > segs.length) msg += `; ${boxes.length - segs.length} extra box(es) kept their timing`;
        showToast(msg + '.', 'success', 5000);
      } catch (err) {
        console.error('Auto-Segment failed', err);
        showToast('Auto-Segment failed: ' + err.message, 'error', 5000);
      } finally {
        btn.disabled = false; otherBtn.disabled = false; btn.textContent = origLabel;
      }
    }

    function revertAutoSegment() {
      if (!autoSegSnapshot) return;
      subtitles = JSON.parse(JSON.stringify(autoSegSnapshot));
      renderAll();
      uploadSubtitles();
      document.getElementById('revertAutoSegBtn').disabled = true;
      showToast('Reverted Signbank timings to the original.', 'success', 3500);
    }

    async function view2DVideo() {
      const url = await razerVideoUrl();
      if (!url) { showToast('No 2D studio video found for this animation', 'error', 4000); return; }
      window.open(url, '_blank');
    }

    document.getElementById('autoSegBtn').addEventListener('click',
      () => runAutoSegment('autoSegBtn', async () => autoSegVideoUrl(), false));
    document.getElementById('autoSeg2DBtn').addEventListener('click',
      () => runAutoSegment('autoSeg2DBtn', razerVideoUrl, true));
    document.getElementById('revertAutoSegBtn').addEventListener('click', revertAutoSegment);
    document.getElementById('view2DBtn').addEventListener('click', view2DVideo);

    // ============================================
    // MCP STATUS DROPDOWNS (persist to sentences table, same pattern as subBeta8)
    // ============================================
    function saveMcpStatus(action, paramName, value) {
      if (!currentSentenceRowId) return;
      const formData = new FormData();
      formData.append('rowId', currentSentenceRowId);
      formData.append(paramName, value);
      fetch('getZinnen.php?action=' + action, { method: 'POST', body: formData })
        .then(r => r.json())
        .then(data => { if (!data.success) console.error('MCP status save failed:', data.error); })
        .catch(err => console.error('MCP status save error:', err));
    }
    (function wireMcpStatus() {
      const p = document.getElementById('mcpStatusPostprocessing');
      const g = document.getElementById('mcpStatusTijdAnnotatie');
      const gvg = document.getElementById('mcpStatusTijdAnnotatieGvg');
      if (p) p.addEventListener('change', () => saveMcpStatus('saveMcpStatusPostprocessing', 'mcpStatusPostprocessing', p.value));
      if (g) g.addEventListener('change', () => saveMcpStatus('saveMcpStatusTijdAnnotatie', 'mcpStatusTijdAnnotatie', g.value));
      if (gvg) gvg.addEventListener('change', () => saveMcpStatus('saveMcpStatusTijdAnnotatieGvg', 'mcpStatusTijdAnnotatieGvg', gvg.value));
    })();

    // ============================================
    // INITIALIZATION
    // ============================================
    // Initialize scene and load base character, then optionally load animation
    (async function() {
      // Initialize Babylon.js scene
      await initializeBabylonScene();

      // Load the studio backdrop behind the avatar (best-effort; non-fatal)
      try {
        await loadBackdrop(scene);
      } catch (err) {
        console.warn("[Backdrop] failed to load:", err);
      }

      // Load base character (skeleton + morph targets)
      await loadBaseCharacter();

      // Check for animation GLB parameter
      const params = new URLSearchParams(window.location.search);
      const glbParam = params.get('glb');
      if (glbParam) {
        await loadAnimationGLB(glbParam);
      }

    function formatTime(seconds) {
      let h = Math.floor(seconds / 3600),
          m = Math.floor((seconds % 3600) / 60),
          s = (seconds % 60).toFixed(3);
      return `${h.toString().padStart(2,'0')}:${m.toString().padStart(2,'0')}:${s.padStart(6,'0')}`;

    // Timeline mouse event updates canvas time
    function updateCanvasTimeByEvent(e) {
      const rect = timelineContainer.getBoundingClientRect();
      const scrollLeft = timelineContainer.scrollLeft;
      const offsetX = e.clientX - rect.left + scrollLeft;
      const newTime = Math.max(0, Math.min(pxToTime(offsetX), animationDuration));
      setCanvasTime(newTime, "mousemove");
    }

    function updatePreviewDiv(e) {
      if (!waitingForEnd) return;
      const rect = timelineContainer.getBoundingClientRect();
      const mouseTime = pxToTime(e.clientX - rect.left + timelineContainer.scrollLeft);
      let startTime = pendingStartTime, endTime = mouseTime;
      if (endTime < startTime) {
        pendingPreviewDiv.style.left = timeToPx(endTime) + 'px';
        pendingPreviewDiv.style.width = (timeToPx(startTime) - timeToPx(endTime)) + 'px';
      } else {
        pendingPreviewDiv.style.left = timeToPx(startTime) + 'px';
        pendingPreviewDiv.style.width = (timeToPx(endTime) - timeToPx(startTime)) + 'px';

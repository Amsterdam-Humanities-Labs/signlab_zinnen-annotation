# Discord Configuration
# Choose ONE of the two methods below:

# Method 1: Discord Bot (Recommended for existing bots)
# Requires: Bot token and Channel ID
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
DISCORD_CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# Method 2: Discord Webhook (Simpler setup)
# To get a webhook URL:
# 1. Go to Discord Server Settings → Integrations → Webhooks
# 2. Click "New Webhook"
# 3. Choose the channel for notifications
# 4. Copy the Webhook URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Note: If both are provided, bot token takes priority

# Google Gemini (processLemmasWithAI.php)
GEMINI_API_KEY=
